             return main_ps(i);
         return fix_color(texBicubic(t0, s0, i.uv));
     }
+
+    float lanczos2(float x) {
+        x = abs(x);
+        if (x < 1e-5)
+            return 1.0;
+        if (x >= 2.0)
+            return 0.0;
+        float px = 3.14159265 * x;
+        return 2.0 * sin(px) * sin(px * 0.5) / (px * px);
+    }
+
+    float4 main_ps_lanczos(VSOut i) : SV_Target {
+        if (all(tS == dS))
+            return main_ps(i);
+        float2 size;
+        t0.GetDimensions(size.x, size.y);
+        float2 centre = i.uv * size - 0.5;
+        float2 stretch = clamp(tS / dS, 1.0, 8.0);
+        float2 reach = 2.0 * stretch;
+        int2 lo = int2(round(uvMin * size));
+        int2 hi = int2(round(uvMax * size)) - 1;
+        int2 first = max(int2(ceil(centre - reach)), lo);
+        int2 last = min(int2(floor(centre + reach)), hi);
+        float4 sum = float4(0.0, 0.0, 0.0, 0.0);
+        float total = 0.0;
+        [loop] for (int y = first.y; y <= last.y; y++) {
+            float wy = lanczos2((y - centre.y) / stretch.y);
+            [loop] for (int x = first.x; x <= last.x; x++) {
+                float w = wy * lanczos2((x - centre.x) / stretch.x);
+                sum += w * t0.Load(int3(x, y, 0));
+                total += w;
+            }
+        }
+        return fix_color(saturate(sum / total));
+    }
 );
 
