+static void lose_duplication(AVFilterContext *avctx)
+{
+    DdagrabContext *dda = avctx->priv;
+
+    release_resource(&dda->dxgi_outdupl);
+    dda->lost_since = dda->reopen_at = av_gettime_relative();
+    av_log(avctx, AV_LOG_WARNING, "Desktop duplication lost, reopening\n");
+}
+
+static int reopen_duplication(AVFilterContext *avctx)
+{
+    DdagrabContext *dda = avctx->priv;
+    int64_t now = av_gettime_relative();
+    int ret;
+
+    if (now < dda->reopen_at) {
+        // Without duplicated frames the caller asks again at once
+        if (!dda->dup_frames)
+            av_usleep(dda->reopen_at - now);
+        return AVERROR(EAGAIN);
+    }
+
+    ret = init_dxgi_dda(avctx, 1);
+    if (ret == AVERROR(EIO))
+        return ret;
+    if (ret < 0) {
+        if (now - dda->lost_since > REOPEN_LIMIT) {
+            av_log(avctx, AV_LOG_ERROR, "Desktop duplication not regained in %d s\n",
+                   (int)(REOPEN_LIMIT / TIMER_RES64));
+            return ret;
+        }
+        dda->reopen_at = now + REOPEN_PERIOD;
+        return AVERROR(EAGAIN);
+    }
+
+    av_log(avctx, AV_LOG_WARNING, "Desktop duplication regained after %d ms\n",
+           (int)((now - dda->lost_since) / 1000));
+    return 0;
+}
