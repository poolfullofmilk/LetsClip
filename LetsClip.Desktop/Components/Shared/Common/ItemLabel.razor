@* Item Label *@
<MudStack Row
          Justify="Justify.SpaceBetween"
          Spacing="4">
    <MudText Typo="Typo.body2"
             Color="Color"
             Class="mud-typography-nowrap flex-shrink-0">
        @Text
    </MudText>
    @if (Detail is not null)
    {
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary ellipsis">
            @Detail
        </MudText>
    }
</MudStack>
