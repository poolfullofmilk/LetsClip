@* Info Icon *@
<Tooltip Content="ChildContent"
         Placement="Placement.Left"
         ShowOnFocus
         RootClass="d-inline-flex cursor-default info-icon">
    <MudElement HtmlTag="span"
                Class="d-inline-flex"
                tabindex="0"
                role="img"
                aria-label="@Label">
        <MudIcon Icon="@AppTheme.InfoIcon"
                 Color="Color.Default"
                 Size="Size.Small" />
    </MudElement>
</Tooltip>
