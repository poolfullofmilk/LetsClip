<MudStack Spacing="2"
          Class="@(Scrolls ? "fill fill-column" : null)">
    @* Header *@
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="1"
              Class="header-row">
        <MudText Typo="Typo.h5"
                 Class="header-title mx-2">
            @Title
        </MudText>
        @TitleContent
    </MudStack>

    @if (Scrolls)
    {
        @* Page Scroll *@
        <MudElement HtmlTag="div"
                    Class="page-scroll">
            @ChildContent
        </MudElement>
    }
    else
    {
        @ChildContent
    }
</MudStack>
