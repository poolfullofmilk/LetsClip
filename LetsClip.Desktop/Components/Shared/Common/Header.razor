<MudStack Spacing="2">
    @* Header *@
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="1"
              Class="header-row">
        <MudText Typo="Typo.h5"
                 Class="header-title mx-2">
            @Title
        </MudText>
        @TitleContent
    </MudStack>

    @ChildContent
</MudStack>
