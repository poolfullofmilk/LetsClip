@* Volume Button *@
<MudElement HtmlTag="div"
            Class="volume">
    <IconButton Icon="@IconOf(Value)"
                Text="@Text"
                Placement="Placement.Left"
                Filled="Filled"
                Disabled="Disabled"
                OnClick="OnClick" />
    @if (!Disabled)
    {
        <MudElement HtmlTag="div"
                    Class="volume-pop">
            <MudPaper Elevation="4"
                      Class="volume-paper">
                @* Volume Slider *@
                <MudSlider T="double"
                           Vertical
                           Value="Value"
                           ValueChanged="SlideAsync"
                           Min="Min"
                           Max="1"
                           Step="Step"
                           Color="Color.Info"
                           Size="Size.Medium"
                           Variant="Variant.Filled"
                           Immediate
                           aria-label="Volume" />
            </MudPaper>
        </MudElement>
    }
</MudElement>
