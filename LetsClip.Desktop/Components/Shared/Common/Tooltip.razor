@* Tooltip *@
<MudTooltip Text="@Text"
            RootClass="@RootClass"
            Placement="Placement"
            Disabled="@(Disabled || string.IsNullOrEmpty(Text))"
            ShowOnFocus="false"
            Delay="Delay"
            Class="@Class"
            Arrow>
    @ChildContent
</MudTooltip>
