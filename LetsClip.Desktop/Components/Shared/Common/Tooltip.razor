@* Tooltip *@
<MudTooltip Text="@Text"
            TooltipContent="Content"
            RootClass="@RootClass"
            Placement="Placement"
            Disabled="@(Disabled || (string.IsNullOrEmpty(Text) && Content is null))"
            ShowOnFocus="ShowOnFocus"
            Class="@PopoverClass"
            Arrow>
    @ChildContent
</MudTooltip>
