@* Panel *@
<MudPaper Elevation="4"
          Class="@($"rounded-panel px-6 py-2 {Class}")"
          id="@Id">
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="1"
              Class="pt-2">
        <MudText Typo="Typo.h6">
            @Title
        </MudText>
        <MudSpacer />
        @Actions
    </MudStack>
    @ChildContent
</MudPaper>
