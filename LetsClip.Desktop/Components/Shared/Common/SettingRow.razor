@* Setting Row *@
<MudStack Row
          AlignItems="AlignItems.Center"
          Spacing="4"
          Class="setting-row">
    <MudText Typo="Typo.subtitle2"
             Class="flex-shrink-0">
        @Title
    </MudText>
    @ChildContent
    @if (Switch is { } on)
    {
        @* Row Switch *@
        <MudSwitch T="bool"
                   Value="on"
                   ValueChanged="SwitchChanged"
                   Color="Color.Info"
                   aria-label="@Title"
                   Disabled="SwitchDisabled"
                   Class="ma-0" />
    }
</MudStack>
