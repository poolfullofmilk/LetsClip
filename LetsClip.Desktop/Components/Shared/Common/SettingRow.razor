@* Setting Row *@
<MudStack Row
          AlignItems="AlignItems.Center"
          Spacing="4"
          Class="setting-row">
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="2"
              Class="flex-grow-1 flex-shrink-0">
        <MudText Typo="Typo.subtitle2">
            @Title
        </MudText>
        @if (Info is { } info)
        {
            <InfoIcon Text="@info" />
        }
    </MudStack>
    @ChildContent
    @if (Switch is { } on)
    {
        @* Row Switch *@
        <MudSwitch T="bool"
                   Value="on"
                   ValueChanged="SwitchChanged"
                   Color="Color.Info"
                   aria-label="@Title"
                   Disabled="SwitchDisabled"
                   Class="ma-0" />
    }
</MudStack>
