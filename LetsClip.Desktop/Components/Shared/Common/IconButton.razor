@* Icon Button *@
<Tooltip Text="@Text"
         Disabled="Disabled"
         RootClass="@RootClass">
    <MudIconButton Icon="@Icon"
                   aria-label="@Text"
                   Variant="@(Filled ? Variant.Filled : Variant.Text)"
                   Color="Color"
                   Size="Size.Small"
                   Disabled="Disabled"
                   OnClick="OnClick" />
</Tooltip>
