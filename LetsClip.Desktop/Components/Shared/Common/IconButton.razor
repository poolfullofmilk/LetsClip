@* Icon Button *@
<Tooltip Text="@Text"
         Placement="Placement"
         Disabled="Disabled">
    <MudIconButton Icon="@Icon"
                   aria-label="@Text"
                   Variant="@(Filled ? Variant.Filled : Variant.Text)"
                   Color="Color"
                   Size="@(Square ? Size.Medium : Size.Small)"
                   Class="@(Square ? "square" : null)"
                   Disabled="Disabled"
                   OnClick="OnClick" />
</Tooltip>
