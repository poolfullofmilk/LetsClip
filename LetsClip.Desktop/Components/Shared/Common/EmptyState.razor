@* Empty State *@
<MudStack AlignItems="AlignItems.Center"
          Justify="Justify.Center"
          Spacing="4"
          Class="pa-8 empty-state">
    <MudIcon Icon="@Icon"
             Size="Size.Large"
             Color="Color"
             Class="@(Color == Color.Default ? "mud-text-secondary" : null)" />
    <MudText Typo="Typo.subtitle1"
             Align="Align.Center"
             Class="mud-text-secondary">
        @Text
    </MudText>
    @ChildContent
</MudStack>
