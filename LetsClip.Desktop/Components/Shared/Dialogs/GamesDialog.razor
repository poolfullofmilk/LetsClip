<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">Games</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary text-relaxed">
                Found in your game libraries or added by you. Removed games stay at the bottom, ready to add back
            </MudText>
            @if (Controller.GameCount is null)
            {
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="2"
                          Class="py-4">
                    <MudProgressCircular Color="Color.Info"
                                         Size="Size.Small"
                                         Indeterminate />
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        Looking for installed games
                    </MudText>
                </MudStack>
            }
            else if (_games.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Rounded.SportsEsports"
                            Text="No Games Found" />
            }
            else
            {
                @* Games Table *@
                <MudTable T="GameEntry"
                          Items="_games"
                          Dense
                          Hover
                          Outlined
                          Elevation="0"
                          Class="fit"
                          Style="max-height:50vh">

                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.body2"
                                     Class="@NameClass(context)">
                                @context.Name
                            </MudText>
                        </MudTd>
                        <MudTd Class="text-center"
                               Style="width:56px">
                            @if (context.IsRemoved)
                            {
                                @* Add Back Button *@
                                <Tooltip Text="Add Back"
                                         RootClass="d-flex justify-center">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Add"
                                                   aria-label="Add Back"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   OnClick="() => Controller.RestoreGame(context.Key)" />
                                </Tooltip>
                            }
                            else
                            {
                                @* Remove Button *@
                                <Tooltip Text="Remove"
                                         RootClass="d-flex justify-center">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Close"
                                                   aria-label="Remove"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="() => Controller.RemoveGame(context.Key)" />
                                </Tooltip>
                            }
                        </MudTd>
                    </RowTemplate>

                </MudTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Add Game Menu *@
        <MudMenu Label="Add Game"
                 StartIcon="@Icons.Material.Rounded.Add"
                 Variant="Variant.Filled"
                 Color="Color.Info"
                 Dense
                 MaxHeight="360"
                 AnchorOrigin="Origin.TopRight"
                 TransformOrigin="Origin.BottomRight">
            <ChildContent>
                @foreach (var app in RunningApps)
                {
                    <MudMenuItem Label="@app.Name"
                                 OnClick="() => Controller.AddGame(app)" />
                }
                @if (RunningApps.Count > 0)
                {
                    <MudDivider />
                }
                @* Browse Item *@
                <MudMenuItem Icon="@Icons.Material.Rounded.FolderOpen"
                             Label="Browse for an Exe"
                             OnClick="BrowseForGame" />
            </ChildContent>
        </MudMenu>
    </DialogActions>

</MudDialog>
