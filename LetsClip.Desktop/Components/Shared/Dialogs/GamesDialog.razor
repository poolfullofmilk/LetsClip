<MudDialog>

    <TitleContent>
        <DialogTitle Text="Games and Apps"
                     Dialog="MudDialog" />
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary text-relaxed">
                Games come from your libraries, apps are added by you. Removed ones stay at the bottom, ready to add back
            </MudText>
            @if (!Controller.GamesScanned)
            {
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="2"
                          Class="py-4">
                    <MudProgressCircular Color="Color.Info"
                                         Size="Size.Small"
                                         Indeterminate />
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        Looking for installed games
                    </MudText>
                </MudStack>
            }
            else if (_games.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Rounded.SportsEsports"
                            Text="No Games or Apps Found" />
            }
            else
            {
                @* Games Table *@
                <MudTable T="GameEntry"
                          Items="_games"
                          Dense
                          Hover
                          Outlined
                          Elevation="0"
                          Class="fit"
                          Style="max-height:50vh">

                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.body2"
                                     Class="@(context.IsRemoved ? "mud-text-disabled" : null)">
                                @context.Name
                            </MudText>
                        </MudTd>
                        <MudTd Class="text-center"
                               Style="width:56px">
                            @if (context.IsRemoved)
                            {
                                @* Add Back Button *@
                                <IconButton Icon="@Icons.Material.Rounded.Add"
                                            Text="Add Back"
                                            Color="Color.Info"
                                            RootClass="d-flex justify-center"
                                            OnClick="() => Controller.SetRemoved(context.Key, false)" />
                            }
                            else
                            {
                                @* Remove Button *@
                                <IconButton Icon="@Icons.Material.Rounded.Close"
                                            Text="Remove"
                                            Color="Color.Error"
                                            RootClass="d-flex justify-center"
                                            OnClick="() => Controller.SetRemoved(context.Key, true)" />
                            }
                        </MudTd>
                    </RowTemplate>

                </MudTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Add Game Menu *@
        <MudMenu Label="Add Game or App"
                 StartIcon="@Icons.Material.Rounded.Add"
                 Variant="Variant.Filled"
                 Color="Color.Info"
                 Dense
                 MaxHeight="360"
                 AnchorOrigin="Origin.TopRight"
                 TransformOrigin="Origin.BottomRight">
            <ChildContent>
                @foreach (var app in RunningApps)
                {
                    <MudMenuItem Label="@app.Name"
                                 OnClick="() => Controller.AddGame(app)" />
                }
                @if (RunningApps.Count > 0)
                {
                    <MudDivider />
                }
                @* Browse Item *@
                <MudMenuItem Icon="@Icons.Material.Rounded.FolderOpen"
                             Label="Browse for an Exe"
                             OnClick="BrowseForGame" />
            </ChildContent>
        </MudMenu>
    </DialogActions>

</MudDialog>
