<MudDialog>

    <TitleContent>
        <DialogTitle Text="Games and Apps"
                     Dialog="MudDialog" />
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @* Game Search *@
            <MudTextField T="string"
                          @bind-Value="_search"
                          Immediate
                          Placeholder="Search"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Search"
                          Clearable
                          ClearIcon="@Icons.Material.Rounded.Clear"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          aria-label="Search Games and Apps"
                          Class="my-0" />
            @if (IsLoading)
            {
                <Loading />
            }
            else if (ShownRows.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Rounded.SearchOff"
                            Text="No Games or Apps Found" />
            }
            else
            {
                @* Games Table *@
                <MudTable T="AddedGame"
                          Items="ShownRows"
                          Dense
                          Hover
                          Outlined
                          Elevation="0"
                          Class="fit games-table"
                          Style="max-height:50vh">

                    <RowTemplate>
                        <MudTd Class="game-icon">
                            @if (_icons.GetValueOrDefault(context.Key) is { Length: > 0 } icon)
                            {
                                <MudImage Src="@icon"
                                          Alt=""
                                          Width="24"
                                          Height="24" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Rounded.SportsEsports"
                                         Class="mud-text-secondary" />
                            }
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2"
                                     Class="ellipsis">
                                <MudHighlighter Text="@context.Name"
                                                HighlightedText="@_search" />
                            </MudText>
                        </MudTd>
                        <MudTd Class="game-switch">
                            @* Record Switch *@
                            <MudSwitch T="bool"
                                       Value="IsRecorded(context)"
                                       ValueChanged="on => SetRecorded(context, on)"
                                       Color="Color.Info"
                                       aria-label="@($"Record {context.Name}")"
                                       Class="ma-0" />
                        </MudTd>
                    </RowTemplate>

                </MudTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Browse Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.FolderOpen"
                   OnClick="BrowseForGame">
            Browse for an Exe
        </MudButton>
    </DialogActions>

</MudDialog>
