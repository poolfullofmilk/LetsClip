<MudDialog>

    <TitleContent>
        <DialogTitle Text="About"
                     Dialog="MudDialog" />
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4"
                  AlignItems="AlignItems.Start">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">@AppInfo.DisplayName</MudText>
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary">
                    @($"{AppInfo.VersionText} · {AppInfo.Author}")
                </MudText>
            </MudStack>
            <MudText Typo="Typo.body1">Keeps the last moments of one monitor in the background, saves them with a hotkey and exports clips small enough for Discord</MudText>
            @* Notices Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.Description"
                       OnClick="OpenNotices">
                Third Party Notices
            </MudButton>
        </MudStack>
    </DialogContent>

</MudDialog>
