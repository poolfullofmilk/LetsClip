<MudDialog>

    <DialogContent>
        @* Delete Question *@
        <MudText Typo="Typo.body1">
            It goes to the Recycle Bin, its exports stay
        </MudText>
    </DialogContent>
    <DialogActions>
        @* No Button *@
        <MudButton Variant="Variant.Text"
                   OnClick="No">
            No
        </MudButton>
        @* Yes Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   OnClick="Yes">
            Yes
        </MudButton>
    </DialogActions>

</MudDialog>
