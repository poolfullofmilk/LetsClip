<MudDialog>

    <TitleContent>
        <DialogTitle Text="@Title"
                     Dialog="MudDialog"
                     Closable="!_isInstalling" />
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2"
                     Class="text-relaxed">
                @($"You have {AppInfo.VersionText}. Updating restarts LetsClip, recording starts again by itself")
            </MudText>
            @if (_changes is [_, ..])
            {
                <ChangeList Changes="_changes" />
            }
            @if (_isInstalling)
            {
                <TransferProgress @ref="_progress"
                                  DoneText="Starting the New Version" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Update Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@(_isInstalling ? null : Icons.Material.Rounded.SystemUpdateAlt)"
                   Disabled="@_isInstalling"
                   OnClick="InstallAsync">
            @(_isInstalling ? "Downloading" : "Update Now")
        </MudButton>
    </DialogActions>

</MudDialog>
