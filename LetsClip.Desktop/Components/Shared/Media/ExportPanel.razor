@* Details Panel *@
<Panel Title="Details"
       Class="compact fade-in">
    @ChildContent
    <SettingRow Title="Fit for Discord">
        @* Discord Plan Select *@
        <MudElement HtmlTag="div"
                    Class="content-field">
            <ChoiceSelect T="DiscordPlan"
                          Value="Plan"
                          ValueChanged="SetPlan"
                          ToStringFunc="PlanLabel"
                          Disabled="@(IsExporting || Busy || !AnyPlanChanges)"
                          RelativeWidth="@DropdownWidth.Adaptive"
                          aria-label="Fit for Discord">
                @foreach (var plan in Enum.GetValues<DiscordPlan>())
                {
                    <MudSelectItem T="DiscordPlan"
                                   Value="plan"
                                   Disabled="@(!Changes(plan))">
                        <ItemLabel Text="@PlanLabel(plan)"
                                   Detail="@PlanDetail(plan)" />
                    </MudSelectItem>
                }
            </ChoiceSelect>
        </MudElement>
    </SettingRow>
    @if (Media.HasAudio)
    {
        <SettingRow Title="Audio">
            @* Audio Button *@
            <IconButton Icon="@(WithAudio ? Icons.Material.Rounded.VolumeUp : Icons.Material.Rounded.VolumeOff)"
                        Text="@(WithAudio ? "Mute Audio" : "Unmute Audio")"
                        Placement="Placement.Left"
                        Color="@(WithAudio ? Color.Default : Color.Error)"
                        Filled
                        Disabled="@(IsExporting || Busy)"
                        OnClick="ToggleAudio" />
        </SettingRow>
    }
    <SettingRow Title="Length">
        <ChangedValue Was="@Formatter.FormatDuration(Media.Duration)"
                      Value="@Formatter.FormatDuration(Range.Length)"
                      data-length />
    </SettingRow>
    <SettingRow Title="Size">
        <ChangedValue Was="@Formatter.FormatSize(Clip.SizeBytes)"
                      Value="@ExportSizeText"
                      Prefix="About"
                      data-copy-audio="@CopyAudioText" />
    </SettingRow>
    <SettingRow Title="Resolution">
        <ChangedValue Was="@SizeText(Media.Width, Media.Height)"
                      Value="@SizeText(OutputSize.Width, OutputSize.Height)" />
    </SettingRow>
    <SettingRow Title="Frame Rate">
        <ChangedValue Was="@RateText(ClipFrameRate)"
                      Value="@RateText(FrameRate)" />
    </SettingRow>
    <SettingRow Title="Bitrate">
        <ChangedValue Was="@Formatter.FormatBitrate(ClipBitsPerSecond)"
                      Value="@BitrateText"
                      Prefix="@(Budget is { VideoBitsPerSecond: > 0 } ? "About" : null)" />
    </SettingRow>

    <MudStack Spacing="3"
              Class="pt-3 pb-4">
        @if (IsTooLong)
        {
            <Notice Text="@TooLongText" />
        }
        else if (Budget?.Verdict == BudgetVerdict.Soft)
        {
            <MudText Typo="Typo.caption"
                     Align="Align.Center"
                     Class="mud-text-secondary">
                Fast motion will look soft at this size, a shorter selection keeps it sharper
            </MudText>
        }

        @if (_progress is { } progress)
        {
            <MudStack Spacing="2"
                      Class="appear">
                <MudStack Row
                          Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">@progress.Phase</MudText>
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        @($"{progress.Fraction * 100:0}%")
                    </MudText>
                </MudStack>
                <MudProgressLinear Color="Color.Info"
                                   Value="@(progress.Fraction * 100)"
                                   Rounded
                                   Size="Size.Medium" />
                @* Cancel Button *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           FullWidth
                           Class="mt-2"
                           OnClick="Cancel">
                    Cancel Export
                </MudButton>
            </MudStack>
        }
        else
        {
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="2">
                @* Export Button *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Rounded.Movie"
                           Disabled="@(!CanExport)"
                           Class="flex-grow-1"
                           OnClick="ExportAsync">
                    @ExportText
                </MudButton>
                @* Save Cut Button *@
                <IconButton Icon="@Icons.Material.Rounded.Save"
                            Text="Save Cut"
                            Placement="Placement.Left"
                            Color="Color.Info"
                            Filled
                            Square
                            Disabled="@(!CanSaveCut)"
                            Busy="Cutting"
                            OnClick="SaveCutAsync" />
            </MudStack>
        }

    </MudStack>
</Panel>

@if (_result is { } result && File.Exists(result))
{
    @* Exported Panel *@
    <Panel Title="Exported"
           Id="exported"
           Class="compact fade-in mt-6">
        <SettingRow Title="File">
            <MudText Typo="Typo.body2"
                     Align="Align.Center"
                     Class="mud-text-secondary two-lines">
                @Path.GetFileName(result)
            </MudText>
        </SettingRow>
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2"
                  Class="pt-3 pb-4">
            @* Copy File Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.ContentCopy"
                       Class="flex-grow-1"
                       OnClick="CopyFile">
                Copy File
            </MudButton>
            @* Show In Folder Button *@
            <IconButton Icon="@Icons.Material.Rounded.FolderOpen"
                        Text="Show in Folder"
                        Placement="Placement.Left"
                        Filled
                        Square
                        OnClick="() => Explorer.ShowFile(result)" />
        </MudStack>
    </Panel>
}
