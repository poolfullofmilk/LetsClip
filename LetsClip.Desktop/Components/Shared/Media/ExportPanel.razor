@* Export Panel *@
<MudPaper Elevation="4"
          Class="rounded-panel px-6 py-2">
    <MudText Typo="Typo.h6"
             Class="pt-2">
        Export
    </MudText>
    <SettingRow Title="Length">
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary player-time"
                 data-length>
            @Formatter.FormatDuration(Range.Length)
        </MudText>
    </SettingRow>
    <MudDivider />
    <SettingRow Title="Original Size">
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @Formatter.FormatSize(Clip.SizeBytes)
        </MudText>
    </SettingRow>
    <MudDivider />
    @if (Limits is { Count: > 1 } limits)
    {
        <SettingRow Title="Size Limit"
                    Info="The exported file stays under this size. Unlimited keeps all the quality the clip has">
            @* Size Limit Select *@
            <MudElement HtmlTag="div"
                        Class="short-width">
                <ChoiceSelect T="double"
                              Value="Limit"
                              ValueChanged="SetLimit"
                              ToStringFunc="LimitLabel"
                              Disabled="@IsExporting"
                              aria-label="Size Limit">
                    @foreach (var limit in limits)
                    {
                        <MudSelectItem T="double"
                                       Value="limit">
                            @LimitLabel(limit)
                        </MudSelectItem>
                    }
                </ChoiceSelect>
            </MudElement>
        </SettingRow>
        <MudDivider />
    }
    <SettingRow Title="Resolution">
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @($"{OutputSize.Width} × {OutputSize.Height}")
        </MudText>
    </SettingRow>
    <MudDivider />
    @if (SourceFrameRate > 60)
    {
        <SettingRow Title="Frame Rate">
            @* Frame Rate Select *@
            <MudElement HtmlTag="div"
                        Class="short-width">
                <ChoiceSelect T="bool"
                              Value="Controller.Settings.ExportFullFrameRate"
                              ValueChanged="SetFullFrameRate"
                              ToStringFunc="FrameRateLabel"
                              Disabled="@IsExporting"
                              aria-label="Frame Rate">
                    <MudSelectItem T="bool"
                                   Value="false">
                        @FrameRateLabel(false)
                    </MudSelectItem>
                    <MudSelectItem T="bool"
                                   Value="true">
                        @FrameRateLabel(true)
                    </MudSelectItem>
                </ChoiceSelect>
            </MudElement>
        </SettingRow>
    }
    else
    {
        <SettingRow Title="Frame Rate">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @($"{FrameRate:0} FPS")
            </MudText>
        </SettingRow>
    }
    <MudDivider />
    @if (Media.HasAudio)
    {
        <SettingRow Title="Audio">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @VolumeText
            </MudText>
            @* Audio Volume Button *@
            <VolumeButton Text="@(WithAudio ? "Mute Audio" : "Unmute Audio")"
                          Disabled="@IsExporting"
                          OnClick="ToggleAudio"
                          Value="@(WithAudio ? Controller.Settings.ExportVolume : 0)"
                          ValueChanged="SetVolume" />
        </SettingRow>
        <MudDivider />
    }
    <SettingRow Title="Bitrate">
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @BitrateText
        </MudText>
        <MudChip T="string"
                 Size="Size.Small"
                 Variant="Variant.Text"
                 Color="@VerdictColor"
                 Class="ma-0">
            @VerdictText
        </MudChip>
    </SettingRow>
    <MudDivider />

    <MudStack Spacing="3"
              Class="pt-3 pb-4">
        @if (VerdictHint is { } hint)
        {
            <MudText Typo="Typo.caption"
                     Class="@VerdictHintClass">
                @hint
            </MudText>
        }

        @if (_progress is { } progress)
        {
            <MudStack Spacing="2"
                      Class="appear">
                <MudStack Row
                          Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">@progress.Phase</MudText>
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        @($"{progress.Fraction * 100:0}%")
                    </MudText>
                </MudStack>
                <MudProgressLinear Color="Color.Info"
                                   Value="@(progress.Fraction * 100)"
                                   Rounded
                                   Size="Size.Medium" />
                @* Cancel Button *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Size="Size.Small"
                           FullWidth
                           OnClick="Cancel">
                    Cancel Export
                </MudButton>
            </MudStack>
        }
        else
        {
            @* Export Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.Movie"
                       Disabled="@(!CanExport)"
                       FullWidth
                       OnClick="ExportAsync">
                @ExportText
            </MudButton>
        }

        @if (_error is { } error)
        {
            <Notice Text="@error" />
        }

        @if (_result is { } result && File.Exists(result))
        {
            <MudPaper Elevation="0"
                      Class="inset rounded-inner pa-3 appear">
                <MudStack Spacing="2">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="2">
                        <MudIcon Icon="@Icons.Material.Rounded.CheckCircle"
                                 Color="Color.Success"
                                 Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2"
                                 Class="ellipsis">
                            @Path.GetFileName(result)
                        </MudText>
                    </MudStack>
                    <MudStack Row
                              Spacing="2">
                        @* Copy File Button *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Rounded.ContentCopy"
                                   Class="flex-grow-1"
                                   OnClick="CopyFile">
                            Copy File
                        </MudButton>
                        @* Show In Folder Button *@
                        <IconButton Icon="@Icons.Material.Rounded.FolderOpen"
                                    Text="Show in Folder"
                                    OnClick="() => Explorer.ShowFile(result)" />
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>
