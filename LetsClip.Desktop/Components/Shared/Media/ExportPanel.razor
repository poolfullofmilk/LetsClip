@* Export Panel *@
<Panel Title="Export"
       Class="compact">
    <SettingRow Title="Length">
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary player-time"
                 data-length>
            @Formatter.FormatDuration(Range.Length)
        </MudText>
    </SettingRow>
    <SettingRow Title="Clip Size">
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @Formatter.FormatSize(Clip.SizeBytes)
        </MudText>
    </SettingRow>
    @if (Limits is { Count: > 1 } limits)
    {
        <SettingRow Title="Size Limit">
            @* Size Limit Select *@
            <MudElement HtmlTag="div"
                        Class="short-width">
                <ChoiceSelect T="double"
                              Value="Limit"
                              ValueChanged="SetLimit"
                              ToStringFunc="LimitLabel"
                              Disabled="@IsExporting"
                              aria-label="Size Limit">
                    @foreach (var limit in limits)
                    {
                        <MudSelectItem T="double"
                                       Value="limit">
                            @LimitLabel(limit)
                        </MudSelectItem>
                    }
                </ChoiceSelect>
            </MudElement>
        </SettingRow>
    }
    <SettingRow Title="Resolution">
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @($"{OutputSize.Width} × {OutputSize.Height}")
        </MudText>
    </SettingRow>
    <SettingRow Title="Frame Rate">
        @if (SourceFrameRate > 60)
        {
            @* Frame Rate Select *@
            <MudElement HtmlTag="div"
                        Class="short-width">
                <ChoiceSelect T="bool"
                              Value="Controller.Settings.ExportFullFrameRate"
                              ValueChanged="SetFullFrameRate"
                              ToStringFunc="FrameRateLabel"
                              Disabled="@IsExporting"
                              aria-label="Frame Rate">
                    <MudSelectItem T="bool"
                                   Value="false">
                        @FrameRateLabel(false)
                    </MudSelectItem>
                    <MudSelectItem T="bool"
                                   Value="true">
                        @FrameRateLabel(true)
                    </MudSelectItem>
                </ChoiceSelect>
            </MudElement>
        }
        else
        {
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @($"{FrameRate:0} FPS")
            </MudText>
        }
    </SettingRow>
    @if (Media.HasAudio)
    {
        <SettingRow Title="Audio">
            @* Audio Button *@
            <IconButton Icon="@(WithAudio ? Icons.Material.Rounded.VolumeUp : Icons.Material.Rounded.VolumeOff)"
                        Text="@(WithAudio ? "Mute Audio" : "Unmute Audio")"
                        Color="@(WithAudio ? Color.Default : Color.Error)"
                        Filled
                        Disabled="@IsExporting"
                        OnClick="ToggleAudio" />
        </SettingRow>
    }
    <SettingRow Title="Bitrate">
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @BitrateText
        </MudText>
    </SettingRow>

    <MudStack Spacing="3"
              Class="pt-3 pb-4">
        @if (VerdictHint is { } hint)
        {
            <MudText Typo="Typo.caption"
                     Align="Align.Center"
                     Class="@VerdictHintClass">
                @hint
            </MudText>
        }

        @if (_progress is { } progress)
        {
            <MudStack Spacing="2"
                      Class="appear">
                <MudStack Row
                          Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">@progress.Phase</MudText>
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        @($"{progress.Fraction * 100:0}%")
                    </MudText>
                </MudStack>
                <MudProgressLinear Color="Color.Info"
                                   Value="@(progress.Fraction * 100)"
                                   Rounded
                                   Size="Size.Medium" />
                @* Cancel Button *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           FullWidth
                           Class="mt-2"
                           OnClick="Cancel">
                    Cancel Export
                </MudButton>
            </MudStack>
        }
        else
        {
            @* Export Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.Movie"
                       Disabled="@(!CanExport)"
                       FullWidth
                       OnClick="ExportAsync">
                @ExportText
            </MudButton>
        }

        @if (_error is { } error)
        {
            <Notice Text="@error" />
        }

        @if (_result is { } result && File.Exists(result))
        {
            <MudPaper Elevation="0"
                      Class="inset rounded-inner pa-3 appear">
                <MudStack Spacing="2">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Justify="Justify.Center"
                              Spacing="2">
                        <MudIcon Icon="@Icons.Material.Rounded.CheckCircle"
                                 Color="Color.Success"
                                 Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2"
                                 Class="ellipsis">
                            @Path.GetFileName(result)
                        </MudText>
                    </MudStack>
                    <MudStack Row
                              Spacing="2">
                        @* Copy File Button *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Rounded.ContentCopy"
                                   Class="flex-grow-1"
                                   OnClick="CopyFile">
                            Copy File
                        </MudButton>
                        @* Show In Folder Button *@
                        <IconButton Icon="@Icons.Material.Rounded.FolderOpen"
                                    Text="Show in Folder"
                                    OnClick="() => Explorer.ShowFile(result)" />
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</Panel>
