@* Details Panel *@
<Panel Title="Details"
       Class="compact fade-in">
    @ChildContent
    <SettingRow Title="Fit for Discord">
        @* Discord Plan Select *@
        <MudElement HtmlTag="div"
                    Class="content-field">
            <ChoiceSelect T="DiscordPlan"
                          Value="Plan"
                          ValueChanged="SetPlan"
                          ToStringFunc="SizeBudget.NameOf"
                          Disabled="@(IsExporting || Busy || !AnyPlanChanges)"
                          RelativeWidth="@DropdownWidth.Adaptive"
                          aria-label="Fit for Discord">
                @foreach (var plan in Enum.GetValues<DiscordPlan>())
                {
                    <MudSelectItem T="DiscordPlan"
                                   Value="plan"
                                   Disabled="@(!Changes(plan))">
                        <ItemLabel Text="@SizeBudget.NameOf(plan)"
                                   Detail="@SizeBudget.LimitTextOf(plan)" />
                    </MudSelectItem>
                }
            </ChoiceSelect>
        </MudElement>
    </SettingRow>
    <SettingRow Title="Video">
        @* Video Button *@
        <IconButton Icon="@(KeepsVideo ? Icons.Material.Rounded.Videocam : Icons.Material.Rounded.VideocamOff)"
                    Text="@(KeepsVideo ? "Leave Out Video" : "Keep Video")"
                    Color="@(KeepsVideo ? Color.Default : Color.Error)"
                    Filled
                    Disabled="@VideoLocked"
                    OnClick="ToggleVideo" />
    </SettingRow>
    @if (Media.HasSeparateTracks)
    {
        <SettingRow Title="Audio">
            @* Game Audio Volume *@
            <VolumeButton Text="@(KeepsGame ? "Mute Game Audio" : "Unmute Game Audio")"
                          Filled
                          Disabled="@SoundLocked(true)"
                          Slides="KeepsMicrophone"
                          OnClick="ToggleAudio"
                          Value="@(KeepsGame ? GameVolume : 0)"
                          ValueChanged="SetGameVolumeAsync" />
            @* Microphone Volume *@
            <VolumeButton Text="@(KeepsMicrophone ? "Mute Microphone" : "Unmute Microphone")"
                          Filled
                          IsMicrophone
                          Disabled="@SoundLocked(false)"
                          Slides="KeepsGame"
                          OnClick="ToggleMicrophone"
                          Value="@(KeepsMicrophone ? MicrophoneVolume : 0)"
                          ValueChanged="SetMicrophoneVolumeAsync" />
        </SettingRow>
    }
    else if (Media.HasAudio)
    {
        <SettingRow Title="Audio">
            @* Audio Button *@
            <IconButton Icon="@(WithAudio ? Icons.Material.Rounded.VolumeUp : Icons.Material.Rounded.VolumeOff)"
                        Text="@(WithAudio ? "Mute Audio" : "Unmute Audio")"
                        Color="@(WithAudio ? Color.Default : Color.Error)"
                        Filled
                        Disabled="@SoundLocked(true)"
                        OnClick="ToggleAudio" />
        </SettingRow>
    }
    <SettingRow Title="Length">
        <ChangedValue Was="@Formatter.FormatDuration(Media.Duration)"
                      Value="@Formatter.FormatDuration(Range.Length)" />
    </SettingRow>
    <SettingRow Title="Size">
        <ChangedValue Was="@ClipSizeText"
                      Value="@ExportSizeText"
                      Prefix="About" />
    </SettingRow>
    <SettingRow Title="Resolution">
        <ChangedValue Was="@ClipResolutionText"
                      Value="@ExportResolutionText" />
    </SettingRow>
    <SettingRow Title="Frame Rate">
        <ChangedValue Was="@ClipFrameRateText"
                      Value="@ExportFrameRateText" />
    </SettingRow>
    <SettingRow Title="Bitrate">
        <ChangedValue Was="@ClipBitrateText"
                      Value="@BitrateText"
                      Prefix="About" />
    </SettingRow>
    <SettingRow Title="Export Time">
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @ExportTimeText
        </MudText>
    </SettingRow>

    <MudStack Spacing="3"
              Class="pt-3 pb-4">
        @if (IsTooLong)
        {
            <Notice Text="@TooLongText" />
        }
        else if (HintText is { } hint)
        {
            <MudText Typo="Typo.caption"
                     Align="Align.Center"
                     Class="mud-text-secondary">
                @hint
            </MudText>
        }

        @if (ShownProgress is { } progress)
        {
            <MudStack Spacing="2"
                      Class="appear">
                <MudStack Row
                          Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">@progress.Phase</MudText>
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        @($"{progress.Fraction * 100:0}%")
                    </MudText>
                </MudStack>
                <MudProgressLinear Color="Color.Info"
                                   Value="@(progress.Fraction * 100)"
                                   Rounded
                                   Size="Size.Medium" />
                @* Cancel Button *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           FullWidth
                           Class="mt-2"
                           OnClick="Cancel">
                    Cancel Export
                </MudButton>
            </MudStack>
        }
        else
        {
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="2">
                @* Export Button *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           StartIcon="@(OnlyCopies ? Icons.Material.Rounded.ContentCopy : Icons.Material.Rounded.Movie)"
                           Disabled="@(!CanExport)"
                           Class="flex-grow-1"
                           OnClick="ExportAsync">
                    @ExportText
                </MudButton>
                @* Save Cut Button *@
                <IconButton Icon="@Icons.Material.Rounded.Save"
                            Text="Save Cut"
                            Color="Color.Info"
                            Filled
                            Square
                            Disabled="@(!CanSaveCut)"
                            Busy="Cutting"
                            OnClick="SaveCutAsync" />
            </MudStack>
        }

    </MudStack>
</Panel>

@if (ExportedFile is { } result)
{
    @* Exported Panel *@
    <Panel Title="Exported"
           Id="exported"
           Class="compact fade-in mt-6">
        @* Exported File *@
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="3"
                  Class="py-2">
            @if (IsSoundOnly(result) || Clip.ThumbnailPath is null)
            {
                <MudElement HtmlTag="div"
                            Class="export-picture d-flex align-center justify-center">
                    <MudIcon Icon="@(IsSoundOnly(result) ? Icons.Material.Rounded.VolumeUp : Icons.Material.Rounded.Movie)"
                             Class="mud-text-secondary" />
                </MudElement>
            }
            else
            {
                <MudImage Src="@DesktopShell.ThumbnailUrl(Clip.ThumbnailPath)"
                          Alt="@Path.GetFileName(result)"
                          Class="export-picture"
                          draggable="false" />
            }
            <MudElement HtmlTag="div"
                        Class="export-text">
                <MudText Typo="Typo.subtitle2"
                         Class="two-lines file-name">
                    @foreach (var word in WordsOf(result))
                    {
                        @(" ")
                        <MudElement HtmlTag="span">@word</MudElement>
                    }
                </MudText>
                <MudText Typo="Typo.caption"
                         Class="mud-text-secondary">
                    @_exportFacts
                </MudText>
            </MudElement>
        </MudStack>
        @if (_leftOut is { } leftOut)
        {
            @* Left Out Chip *@
            <MudStack Row
                      Class="appear pt-1">
                <MudChip T="string"
                         Icon="@leftOut.Icon"
                         IconColor="Color.Error"
                         Size="Size.Small"
                         Variant="Variant.Text"
                         Class="ma-0">
                    @leftOut.Text
                </MudChip>
            </MudStack>
        }
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2"
                  Class="pt-3 pb-4">
            @* Copy File Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.ContentCopy"
                       Class="flex-grow-1"
                       OnClick="CopyFile">
                Copy File
            </MudButton>
            @* Show In Folder Button *@
            <IconButton Icon="@Icons.Material.Rounded.FolderOpen"
                        Text="Show in Folder"
                        Filled
                        Square
                        OnClick="() => Explorer.ShowFile(result)" />
        </MudStack>
    </Panel>
}
