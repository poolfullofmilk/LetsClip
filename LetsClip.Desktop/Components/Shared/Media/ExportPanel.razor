@* Export Panel *@
<MudPaper Elevation="4"
          Class="rounded-panel px-6 py-2">
    <MudText Typo="Typo.h6"
             Class="pt-2">
        Export
    </MudText>
    @if (Limits is { Count: > 1 } limits)
    {
        <SettingRow Title="Size Limit"
                    Info="The exported file stays under this size. Unlimited keeps all the quality the clip has">
            @* Size Limit Select *@
            <MudElement HtmlTag="div"
                        Class="fixed-width narrow">
                <MudSelect T="double"
                           Value="Limit"
                           ValueChanged="SetLimit"
                           ToStringFunc="LimitLabel"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense
                           Disabled="@IsExporting"
                           aria-label="Size Limit"
                           AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft"
                           Class="my-0">
                    @foreach (var limit in limits)
                    {
                        <MudSelectItem T="double"
                                       Value="limit">
                            @LimitLabel(limit)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudElement>
        </SettingRow>
        <MudDivider />
    }
    @if (SourceFrameRate > 60)
    {
        <SettingRow Title="Frame Rate">
            @* Frame Rate Select *@
            <MudElement HtmlTag="div"
                        Class="fixed-width narrow">
                <MudSelect T="bool"
                           Value="Controller.Settings.ExportFullFrameRate"
                           ValueChanged="SetFullFrameRate"
                           ToStringFunc="FrameRateLabel"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense
                           Disabled="@IsExporting"
                           aria-label="Frame Rate"
                           AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft"
                           Class="my-0">
                    <MudSelectItem T="bool"
                                   Value="false">
                        @FrameRateLabel(false)
                    </MudSelectItem>
                    <MudSelectItem T="bool"
                                   Value="true">
                        @FrameRateLabel(true)
                    </MudSelectItem>
                </MudSelect>
            </MudElement>
        </SettingRow>
        <MudDivider />
    }
    @if (Media.HasAudio)
    {
        <SettingRow Title="Audio">
            @* Audio Switch *@
            <MudSwitch T="bool"
                       @bind-Value="IncludeAudio"
                       Color="Color.Info"
                       Disabled="@IsExporting"
                       aria-label="Include Audio"
                       Class="ma-0" />
        </SettingRow>
        <MudDivider />
    }

    <MudStack Spacing="3"
              Class="py-3">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Spacing="2">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @BudgetText
            </MudText>
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Text"
                     Color="@VerdictColor"
                     Class="ma-0">
                @VerdictText
            </MudChip>
        </MudStack>
        @if (VerdictHint is { } hint)
        {
            <MudText Typo="Typo.caption"
                     Class="@VerdictHintClass">
                @hint
            </MudText>
        }

        @if (_progress is { } progress)
        {
            <MudStack Spacing="2">
                <MudStack Row
                          Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">@progress.Phase</MudText>
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        @($"{progress.Fraction * 100:0}%")
                    </MudText>
                </MudStack>
                <MudProgressLinear Color="Color.Info"
                                   Value="@(progress.Fraction * 100)"
                                   Size="Size.Small" />
                @* Cancel Button *@
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Size="Size.Small"
                           FullWidth
                           OnClick="Cancel">
                    Cancel Export
                </MudButton>
            </MudStack>
        }
        else
        {
            @* Export Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.Movie"
                       Disabled="@(!CanExport)"
                       FullWidth
                       OnClick="ExportAsync">
                @ExportLabel
            </MudButton>
        }

        @if (_error is { } error)
        {
            <Notice Text="@error" />
        }

        @if (_result is { } result && File.Exists(result.Path))
        {
            <MudPaper Elevation="0"
                      Class="inset rounded-inner pa-3">
                <MudStack Spacing="2">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="2">
                        <MudIcon Icon="@Icons.Material.Rounded.CheckCircle"
                                 Color="Color.Success"
                                 Size="Size.Small" />
                        <MudStack Spacing="0"
                                  Style="min-width:0">
                            <MudText Typo="Typo.subtitle2"
                                     Class="ellipsis">
                                @Path.GetFileName(result.Path)
                            </MudText>
                            <MudText Typo="Typo.caption"
                                     Class="mud-text-secondary">
                                @ResultText(result)
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudStack Row
                              Spacing="2">
                        @* Copy File Button *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Rounded.ContentCopy"
                                   Class="flex-grow-1"
                                   OnClick="CopyFile">
                            Copy File
                        </MudButton>
                        @* Show In Folder Button *@
                        <Tooltip Text="Show in Folder"
                                 RootClass="d-flex">
                            <MudIconButton Icon="@Icons.Material.Rounded.FolderOpen"
                                           aria-label="Show in Folder"
                                           Size="Size.Small"
                                           OnClick="() => Explorer.ShowFile(result.Path)" />
                        </Tooltip>
                        @* Drag Handle *@
                        <Tooltip Text="Drag to Another App"
                                 RootClass="d-flex">
                            <MudElement HtmlTag="span"
                                        Class="drag-handle d-flex align-center pa-1"
                                        aria-label="Drag to Another App"
                                        @onmousedown="() => DesktopShell.DragFile(result.Path)">
                                <MudIcon Icon="@Icons.Material.Rounded.DragIndicator"
                                         Size="Size.Small" />
                            </MudElement>
                        </Tooltip>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>
