@* Export Panel *@
<MudPaper Elevation="4"
          Class="rounded-panel px-6 py-2">
    <MudText Typo="Typo.h6"
             Class="pt-2">
        Export
    </MudText>
    <MudStack Spacing="1"
              Class="py-3">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="1">
            <MudText Typo="Typo.subtitle2">Size Limit</MudText>
            <InfoIcon Text="Free Discord accounts upload up to 10 MB and Nitro raises it. Discord can change this, LetsClip cannot check yours" />
            <MudSpacer />
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @Formatter.FormatMegabytes(Megabytes)
            </MudText>
        </MudStack>
        @* Size Slider *@
        <MudSlider T="double"
                   @bind-Value="Megabytes"
                   Min="SizeBudget.MinimumMegabytes"
                   Max="MaximumMegabytes"
                   Step="1"
                   Color="Color.Info"
                   Size="Size.Medium"
                   Variant="Variant.Filled"
                   Immediate
                   Disabled="@IsExporting"
                   aria-label="Size Limit" />
    </MudStack>
    @if (CanShrink)
    {
        <MudDivider />
        <SettingRow Title="Resolution">
            @* Resolution Buttons *@
            <MudButtonGroup OverrideStyles="false"
                            Size="Size.Small">
                <MudButton Variant="Variant.Filled"
                           Color="@(Use720p ? Color.Default : Color.Info)"
                           Size="Size.Small"
                           Disabled="@IsExporting"
                           OnClick="() => SetResolution(false)">
                    @OriginalLabel
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="@(Use720p ? Color.Info : Color.Default)"
                           Size="Size.Small"
                           Disabled="@IsExporting"
                           OnClick="() => SetResolution(true)">
                    720p
                </MudButton>
            </MudButtonGroup>
        </SettingRow>
    }
    @if (SourceFrameRate > 60)
    {
        <MudDivider />
        <SettingRow Title="Frame Rate">
            @* Frame Rate Buttons *@
            <MudButtonGroup OverrideStyles="false"
                            Size="Size.Small">
                <MudButton Variant="Variant.Filled"
                           Color="@(Controller.Settings.ExportFullFrameRate ? Color.Default : Color.Info)"
                           Size="Size.Small"
                           Disabled="@IsExporting"
                           OnClick="() => SetFullFrameRate(false)">
                    60 FPS
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="@(Controller.Settings.ExportFullFrameRate ? Color.Info : Color.Default)"
                           Size="Size.Small"
                           Disabled="@IsExporting"
                           OnClick="() => SetFullFrameRate(true)">
                    @($"{SourceFrameRate} FPS")
                </MudButton>
            </MudButtonGroup>
        </SettingRow>
    }
    @if (Media.HasAudio)
    {
        <MudDivider />
        <SettingRow Title="Audio">
            @* Audio Switch *@
            <MudSwitch T="bool"
                       Value="_includeAudio"
                       ValueChanged="SetAudio"
                       Color="Color.Info"
                       Disabled="@IsExporting"
                       aria-label="Include Audio"
                       Class="ma-0" />
        </SettingRow>
    }
    <MudDivider />

    <MudStack Spacing="3"
              Class="py-3">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Spacing="2">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @BudgetText
            </MudText>
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Text"
                     Color="@VerdictColor"
                     Class="ma-0">
                @VerdictText
            </MudChip>
        </MudStack>
        @if (VerdictHint is { } hint)
        {
            <MudText Typo="Typo.caption"
                     Class="@VerdictHintClass">
                @hint
            </MudText>
        }

        @if (_progress is { } progress)
        {
            <MudStack Spacing="2">
                <MudStack Row
                          Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">@progress.Phase</MudText>
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        @($"{progress.Fraction * 100:0}%")
                    </MudText>
                </MudStack>
                <MudProgressLinear Color="Color.Info"
                                   Value="@(progress.Fraction * 100)"
                                   Size="Size.Small" />
                @* Cancel Button *@
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Size="Size.Small"
                           FullWidth
                           OnClick="Cancel">
                    Cancel Export
                </MudButton>
            </MudStack>
        }
        else
        {
            @* Export Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.Movie"
                       Disabled="@(!CanExport)"
                       FullWidth
                       OnClick="ExportAsync">
                @ExportLabel
            </MudButton>
        }

        @if (_error is { } error)
        {
            <MudAlert Severity="Severity.Warning"
                      Dense
                      Elevation="4"
                      Class="rounded-panel mud-warning-text">
                @error
            </MudAlert>
        }

        @if (_result is { } result && File.Exists(result.Path))
        {
            <MudPaper Elevation="0"
                      Class="inset rounded-inner pa-3">
                <MudStack Spacing="2">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="2">
                        <MudIcon Icon="@Icons.Material.Rounded.CheckCircle"
                                 Color="Color.Success"
                                 Size="Size.Small" />
                        <MudStack Spacing="0"
                                  Style="min-width:0">
                            <MudText Typo="Typo.subtitle2"
                                     Class="ellipsis">
                                @Path.GetFileName(result.Path)
                            </MudText>
                            <MudText Typo="Typo.caption"
                                     Class="mud-text-secondary">
                                @ResultText(result)
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudStack Row
                              Spacing="2">
                        @* Copy File Button *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Rounded.ContentCopy"
                                   Class="flex-grow-1"
                                   OnClick="CopyFile">
                            Copy File
                        </MudButton>
                        @* Show In Folder Button *@
                        <Tooltip Text="Show in Folder"
                                 RootClass="d-flex">
                            <MudIconButton Icon="@Icons.Material.Rounded.FolderOpen"
                                           aria-label="Show in Folder"
                                           Size="Size.Small"
                                           OnClick="() => Explorer.ShowFile(result.Path)" />
                        </Tooltip>
                        @* Drag Handle *@
                        <Tooltip Text="Drag Into Discord"
                                 RootClass="d-flex">
                            <MudElement HtmlTag="span"
                                        Class="drag-handle d-flex align-center pa-1"
                                        aria-label="Drag Into Discord"
                                        @onmousedown="() => DesktopShell.DragFile(result.Path)">
                                <MudIcon Icon="@Icons.Material.Rounded.DragIndicator"
                                         Size="Size.Small" />
                            </MudElement>
                        </Tooltip>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>
