@* Trim Field *@
<MudElement HtmlTag="div"
            Class="trim-field"
            data-edge="@Label"
            data-seconds="@Formatter.FormatSeconds(Value)">
    @* Time Field *@
    <MudTextField @key="_version"
                  T="string"
                  Label="@Label"
                  Value="@Formatter.FormatDuration(Value)"
                  ValueChanged="CommitAsync"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icon"
                  AdornmentAriaLabel="@($"Set {Label} Here")"
                  OnAdornmentClick="() => OnSet.InvokeAsync()"
                  IconSize="Size.Small"
                  Disabled="Disabled"
                  Class="my-0" />
    <MudElement HtmlTag="div"
                Class="trim-spin">
        @* Later Button *@
        <MudIconButton Icon="@Icons.Material.Rounded.KeyboardArrowUp"
                       aria-label="@($"{Label} Later")"
                       Size="Size.Small"
                       tabindex="-1"
                       Disabled="Disabled"
                       OnClick="() => OnStep.InvokeAsync(1)" />
        @* Earlier Button *@
        <MudIconButton Icon="@Icons.Material.Rounded.KeyboardArrowDown"
                       aria-label="@($"{Label} Earlier")"
                       Size="Size.Small"
                       tabindex="-1"
                       Disabled="Disabled"
                       OnClick="() => OnStep.InvokeAsync(-1)" />
    </MudElement>
</MudElement>
