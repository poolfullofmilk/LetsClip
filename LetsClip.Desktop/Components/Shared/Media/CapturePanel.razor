@* Capture Header *@
<Header Title="Capture">
    <ChildContent>
        @* Capture Panel *@
        <MudPaper Elevation="4"
                  Class="rounded-panel px-6 py-2">
            @if (Controller.Settings.GamesOnly)
            {
                <SettingRow Title="Game">
                    <MudStack Spacing="0"
                              AlignItems="AlignItems.End"
                              Style="min-width:0">
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary ellipsis">
                            @(Controller.Games.GameName ?? "Waiting for a Game")
                        </MudText>
                        @* Settings Link *@
                        <MudLink Typo="Typo.caption"
                                 Color="Color.Info"
                                 Href="settings">
                            or Record a Monitor
                        </MudLink>
                    </MudStack>
                </SettingRow>
            }
            else
            {
                <SettingField Title="Monitor">
                    @* Monitor Select *@
                    <MudSelect T="MonitorInfo"
                               Value="Controller.SelectedMonitor"
                               ValueChanged="SelectMonitor"
                               OpenChanged="OutlineMonitors"
                               ToStringFunc="MonitorLabel"
                               Placeholder="Pick the Monitor to Record"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense
                               aria-label="Monitor"
                               AnchorOrigin="Origin.BottomLeft"
                               TransformOrigin="Origin.TopLeft"
                               Class="my-0">
                        @foreach (var monitor in Controller.Monitors)
                        {
                            <MudSelectItem T="MonitorInfo"
                                           Value="monitor">
                                <MudStack Row
                                          Justify="Justify.SpaceBetween"
                                          AlignItems="AlignItems.Center"
                                          Spacing="4">
                                    <MudText Typo="Typo.body2">@monitor.FriendlyName</MudText>
                                    <MudStack Spacing="0"
                                              AlignItems="AlignItems.End">
                                        <MudText Typo="Typo.body2"
                                                 Class="mud-text-secondary">
                                            @($"{monitor.Width} × {monitor.Height}")
                                        </MudText>
                                        <MudText Typo="Typo.body2"
                                                 Class="mud-text-secondary">
                                            @($"{monitor.RefreshRate} Hz")
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </SettingField>
            }
            <MudDivider />
            <SettingField Title="Replay Length">
                @* Replay Length Select *@
                <MudSelect T="int"
                           Value="Controller.Settings.ReplaySeconds"
                           ValueChanged="SetReplay"
                           ToStringFunc="ReplayLabel"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense
                           aria-label="Replay Length"
                           AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft"
                           Class="my-0">
                    @foreach (var seconds in UserSettings.ReplayChoices)
                    {
                        <MudSelectItem T="int"
                                       Value="seconds">
                            @ReplayLabel(seconds)
                        </MudSelectItem>
                    }
                </MudSelect>
            </SettingField>
            <MudDivider />
            <SettingField Title="Resolution">
                @* Resolution Select *@
                <MudSelect T="int"
                           Value="Controller.Resolution"
                           ValueChanged="SetResolution"
                           ToStringFunc="ResolutionLabel"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense
                           aria-label="Resolution"
                           AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft"
                           Class="my-0">
                    @foreach (var lines in Controller.ResolutionChoices)
                    {
                        <MudSelectItem T="int"
                                       Value="lines">
                            <MudText Typo="Typo.body2"
                                     Color="@ResolutionColor(lines)">
                                @ResolutionLabel(lines)
                            </MudText>
                        </MudSelectItem>
                    }
                </MudSelect>
            </SettingField>
            <MudDivider />
            <SettingField Title="Quality">
                @* Quality Select *@
                <MudSelect T="CaptureQuality"
                           Value="Controller.Settings.Quality"
                           ValueChanged="SetQuality"
                           ToStringFunc="QualityLabel"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense
                           aria-label="Quality"
                           AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft"
                           Class="my-0">
                    @foreach (var quality in Enum.GetValues<CaptureQuality>())
                    {
                        <MudSelectItem T="CaptureQuality"
                                       Value="quality">
                            <MudText Typo="Typo.body2"
                                     Color="@QualityColor(quality)">
                                @QualityLabel(quality)
                            </MudText>
                        </MudSelectItem>
                    }
                </MudSelect>
            </SettingField>
            <MudDivider />
            <SettingField Title="Frame Rate">
                @* Frame Rate Select *@
                <MudSelect T="int"
                           Value="Controller.FrameRate"
                           ValueChanged="SetFrameRate"
                           ToStringFunc="FrameRateLabel"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense
                           aria-label="Frame Rate"
                           AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft"
                           Class="my-0">
                    @foreach (var rate in Controller.FrameRateChoices)
                    {
                        <MudSelectItem T="int"
                                       Value="rate">
                            <MudText Typo="Typo.body2"
                                     Color="@FrameRateColor(rate)">
                                @FrameRateLabel(rate)
                            </MudText>
                        </MudSelectItem>
                    }
                </MudSelect>
            </SettingField>
            <MudStack Spacing="3"
                      Class="py-3">
                @if (Alert is { } alert)
                {
                    <Notice Text="@alert.Text"
                            Severity="@alert.Severity" />
                }

                @if (Status.State == CaptureState.Error)
                {
                    @* Try Again Button *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Rounded.Refresh"
                               FullWidth
                               Class="icon-left"
                               OnClick="TryAgainAsync">
                        Try Again
                    </MudButton>
                }
                else
                {
                    @* Save Button *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Rounded.Save"
                               Disabled="@(!Controller.IsRecording)"
                               FullWidth
                               Class="icon-left"
                               OnClick="SaveAsync">
                        <MudStack Spacing="0"
                                  AlignItems="AlignItems.Center">
                            @($"Save Last {Controller.Settings.ReplaySeconds} Seconds")
                            @if (Shell.HotkeyProblem is null)
                            {
                                <MudText Typo="Typo.caption"
                                         Class="button-hint">
                                    @($"or {Controller.Settings.Hotkey}")
                                </MudText>
                            }
                        </MudStack>
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    </ChildContent>
</Header>
