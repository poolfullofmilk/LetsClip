@* Capture Header *@
<Header Title="Capture">
    <ChildContent>
        @* Capture Panel *@
        <MudPaper Elevation="4"
                  Class="rounded-panel px-6 py-2">
            @if (Controller.Settings.GamesOnly)
            {
                <SettingRow Title="Game">
                    <MudStack Spacing="0"
                              AlignItems="AlignItems.End"
                              Style="min-width:0">
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary ellipsis">
                            @(Controller.Games.GameName ?? "Waiting for a Game")
                        </MudText>
                        @* Settings Link *@
                        <MudLink Typo="Typo.caption"
                                 Color="Color.Info"
                                 Href="settings">
                            Or Record a Monitor
                        </MudLink>
                    </MudStack>
                </SettingRow>
            }
            else
            {
                <MudStack Spacing="2"
                          Class="py-3">
                    <MudText Typo="Typo.subtitle2">Monitor</MudText>
                    @* Monitor Select *@
                    <MudSelect T="MonitorInfo"
                               Value="Controller.SelectedMonitor"
                               ValueChanged="SelectMonitor"
                               OpenChanged="OutlineMonitors"
                               ToStringFunc="MonitorLabel"
                               Placeholder="Pick the Monitor to Record"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense
                               aria-label="Monitor"
                               AnchorOrigin="Origin.BottomLeft"
                               TransformOrigin="Origin.TopLeft"
                               Class="my-0">
                        @foreach (var monitor in Controller.Monitors)
                        {
                            <MudSelectItem T="MonitorInfo"
                                           Value="monitor">
                                <MudStack Row
                                          Justify="Justify.SpaceBetween"
                                          Spacing="4">
                                    <MudText Typo="Typo.body2">@monitor.FriendlyName</MudText>
                                    <MudText Typo="Typo.body2"
                                             Class="mud-text-secondary">
                                        @MonitorDetails(monitor)
                                    </MudText>
                                </MudStack>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
            }
            <MudDivider />
            <SettingRow Title="Replay Length">
                @* Replay Length Buttons *@
                <MudButtonGroup OverrideStyles="false"
                                Size="Size.Small">
                    @foreach (var seconds in UserSettings.ReplayChoices)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="@(seconds == Controller.Settings.ReplaySeconds ? Color.Info : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="() => SetReplay(seconds)">
                            @($"{seconds}s")
                        </MudButton>
                    }
                </MudButtonGroup>
            </SettingRow>
            @if (NativeLabel is { } nativeLabel)
            {
                <MudDivider />
                <SettingRow Title="Resolution">
                    @* Resolution Buttons *@
                    <MudButtonGroup OverrideStyles="false"
                                    Size="Size.Small">
                        <MudButton Variant="Variant.Filled"
                                   Color="@(Controller.Settings.FullResolution ? Color.Default : Color.Info)"
                                   Size="Size.Small"
                                   OnClick="() => SetFullResolution(false)">
                            1080p
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="@(Controller.Settings.FullResolution ? Color.Info : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="() => SetFullResolution(true)">
                            @nativeLabel
                        </MudButton>
                    </MudButtonGroup>
                </SettingRow>
            }
            <MudDivider />
            <SettingRow Title="Quality">
                @* Quality Buttons *@
                <MudButtonGroup OverrideStyles="false"
                                Size="Size.Small">
                    @foreach (var quality in Enum.GetValues<CaptureQuality>())
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="@(quality == Controller.Settings.Quality ? Color.Info : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="() => SetQuality(quality)">
                            @quality
                        </MudButton>
                    }
                </MudButtonGroup>
            </SettingRow>
            <MudDivider />
            <SettingRow Title="Frame Rate">
                @* Frame Rate Select *@
                <MudElement HtmlTag="div"
                            Class="fixed-width narrow">
                    <MudSelect T="int"
                               Value="Controller.FrameRate"
                               ValueChanged="SetFrameRate"
                               ToStringFunc="FrameRateLabel"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense
                               aria-label="Frame Rate"
                               AnchorOrigin="Origin.BottomLeft"
                               TransformOrigin="Origin.TopLeft"
                               Class="my-0">
                        @foreach (var rate in Controller.FrameRateChoices)
                        {
                            <MudSelectItem T="int"
                                           Value="rate">
                                @FrameRateLabel(rate)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudElement>
            </SettingRow>

            <MudStack Spacing="3"
                      Class="py-3">
                @if (Alert is { } alert)
                {
                    <MudAlert Severity="@alert.Severity"
                              Dense
                              Elevation="4"
                              Class="@AlertClass(alert.Severity)">
                        @alert.Text
                    </MudAlert>
                }

                @if (!Controller.Settings.HasSeenCaptureNotice)
                {
                    @* Start Button *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Rounded.FiberManualRecord"
                               FullWidth
                               OnClick="StartAsync">
                        Start Buffering
                    </MudButton>
                }
                else if (Status.State == CaptureState.Error)
                {
                    @* Try Again Button *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Rounded.Refresh"
                               FullWidth
                               OnClick="StartAsync">
                        Try Again
                    </MudButton>
                }
                else
                {
                    @* Save Button *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Rounded.Save"
                               Disabled="@(!Status.IsBuffering)"
                               FullWidth
                               OnClick="SaveAsync">
                        @($"Save Last {Controller.Settings.ReplaySeconds} Seconds")
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    </ChildContent>
</Header>
