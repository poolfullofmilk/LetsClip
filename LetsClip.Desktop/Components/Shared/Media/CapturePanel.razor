@* Capture Header *@
<Header Title="Capture">
    <TitleContent>
        <MudSpacer />
        @* Recommended Button *@
        <IconButton Icon="@Icons.Material.Rounded.AutoFixHigh"
                    Text="Use Recommended Settings"
                    Disabled="IsRecommended"
                    OnClick="UseRecommended" />
    </TitleContent>
    <ChildContent>
        @* Capture Panel *@
        <MudPaper Elevation="4"
                  Class="rounded-panel px-6 py-2">
            @if (Controller.Settings.GamesOnly)
            {
                <SettingRow Title="Game or App">
                    <MudStack Spacing="0"
                              AlignItems="AlignItems.End"
                              Style="min-width:0">
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary ellipsis">
                            @(Controller.Games.GameName ?? "Waiting for a Game or App")
                        </MudText>
                        @* Settings Link *@
                        <MudLink Typo="Typo.caption"
                                 Color="Color.Info"
                                 Href="settings">
                            or Record a Monitor
                        </MudLink>
                    </MudStack>
                </SettingRow>
                <MudDivider />
            }
            <MudStack Spacing="5"
                      Class="pt-6 pb-4">
                @if (!Controller.Settings.GamesOnly)
                {
                    @* Monitor Select *@
                    <FieldDetail Detail="@MonitorDetail(Controller.SelectedMonitor)">
                        <MudSelect T="MonitorInfo"
                                   Label="Monitor"
                                   OpenIcon="@Icons.Material.Rounded.ArrowDropDown"
                                   CloseIcon="@Icons.Material.Rounded.ArrowDropUp"
                                   Value="Controller.SelectedMonitor"
                                   ValueChanged="SelectMonitor"
                                   OpenChanged="OutlineMonitors"
                                   ToStringFunc="MonitorLabel"
                                   Placeholder="Pick the Monitor to Record"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense
                                   Class="my-0">
                            @foreach (var monitor in Controller.Monitors)
                            {
                                <MudSelectItem T="MonitorInfo"
                                               Value="monitor">
                                    <MudStack Row
                                              Justify="Justify.SpaceBetween"
                                              AlignItems="AlignItems.Center"
                                              Spacing="4">
                                        <MudText Typo="Typo.body2">@monitor.FriendlyName</MudText>
                                        <MudStack Spacing="0"
                                                  AlignItems="AlignItems.End">
                                            <MudText Typo="Typo.body2"
                                                     Class="mud-text-secondary">
                                                @($"{monitor.Width} × {monitor.Height}")
                                            </MudText>
                                            <MudText Typo="Typo.body2"
                                                     Class="mud-text-secondary">
                                                @($"{monitor.RefreshRate} Hz")
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </FieldDetail>
                }
                @* Replay Length Select *@
                <MudSelect T="int"
                           Label="Replay Length"
                           OpenIcon="@Icons.Material.Rounded.ArrowDropDown"
                           CloseIcon="@Icons.Material.Rounded.ArrowDropUp"
                           Value="Controller.Settings.ReplaySeconds"
                           ValueChanged="SetReplay"
                           ToStringFunc="ReplayLabel"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense
                           Class="my-0">
                    @foreach (var seconds in UserSettings.ReplayChoices)
                    {
                        <MudSelectItem T="int"
                                       Value="seconds">
                            @ReplayLabel(seconds)
                        </MudSelectItem>
                    }
                </MudSelect>
                @* Resolution Select *@
                <FieldDetail Color="@ResolutionColor(Controller.Resolution)"
                             Detail="@RecommendedText(Controller.Resolution == Controller.RecommendedResolution)">
                    <MudSelect T="int"
                               Label="Resolution"
                               OpenIcon="@Icons.Material.Rounded.ArrowDropDown"
                               CloseIcon="@Icons.Material.Rounded.ArrowDropUp"
                               Value="Controller.Resolution"
                               ValueChanged="SetResolution"
                               ToStringFunc="ResolutionLabel"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense
                               Class="my-0">
                        @foreach (var lines in Controller.ResolutionChoices)
                        {
                            <MudSelectItem T="int"
                                           Value="lines">
                                <ItemLabel Text="@ResolutionLabel(lines)"
                                           Color="@ResolutionColor(lines)"
                                           Detail="@RecommendedText(lines == Controller.RecommendedResolution)" />
                            </MudSelectItem>
                        }
                    </MudSelect>
                </FieldDetail>
                @* Quality Select *@
                <FieldDetail Color="@QualityColor(Controller.Settings.Quality)"
                             Detail="@RecommendedText(Controller.Settings.Quality == CaptureQuality.Normal)">
                    <MudSelect T="CaptureQuality"
                               Label="Quality"
                               OpenIcon="@Icons.Material.Rounded.ArrowDropDown"
                               CloseIcon="@Icons.Material.Rounded.ArrowDropUp"
                               Value="Controller.Settings.Quality"
                               ValueChanged="SetQuality"
                               ToStringFunc="QualityLabel"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense
                               Class="my-0">
                        @foreach (var quality in Enum.GetValues<CaptureQuality>())
                        {
                            <MudSelectItem T="CaptureQuality"
                                           Value="quality">
                                <ItemLabel Text="@QualityLabel(quality)"
                                           Color="@QualityColor(quality)"
                                           Detail="@RecommendedText(quality == CaptureQuality.Normal)" />
                            </MudSelectItem>
                        }
                    </MudSelect>
                </FieldDetail>
                @* Frame Rate Select *@
                <FieldDetail Color="@FrameRateColor(Controller.FrameRate)"
                             Detail="@RecommendedText(Controller.FrameRate == Controller.RecommendedFrameRate)">
                    <MudSelect T="int"
                               Label="Frame Rate"
                               OpenIcon="@Icons.Material.Rounded.ArrowDropDown"
                               CloseIcon="@Icons.Material.Rounded.ArrowDropUp"
                               Value="Controller.FrameRate"
                               ValueChanged="SetFrameRate"
                               ToStringFunc="FrameRateLabel"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense
                               Class="my-0">
                        @foreach (var rate in Controller.FrameRateChoices)
                        {
                            <MudSelectItem T="int"
                                           Value="rate">
                                <ItemLabel Text="@FrameRateLabel(rate)"
                                           Color="@FrameRateColor(rate)"
                                           Detail="@RecommendedText(rate == Controller.RecommendedFrameRate)" />
                            </MudSelectItem>
                        }
                    </MudSelect>
                </FieldDetail>
                @if (Alert is { } alert)
                {
                    <Notice Text="@alert.Text"
                            Severity="@alert.Severity" />
                }

                @if (Controller.ShowsError)
                {
                    @* Try Again Button *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Rounded.Refresh"
                               FullWidth
                               Class="icon-left"
                               OnClick="TryAgainAsync">
                        Try Again
                    </MudButton>
                }
                else
                {
                    @* Save Button *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@(Status.IsSaving ? null : Icons.Material.Rounded.Save)"
                               Disabled="@(!Controller.IsRecording)"
                               FullWidth
                               Class="icon-left"
                               OnClick="SaveAsync">
                        @if (Status.IsSaving)
                        {
                            <MudElement HtmlTag="span"
                                        Class="mud-button-icon-start">
                                <MudProgressCircular Indeterminate
                                                     Class="button-spinner" />
                            </MudElement>
                        }
                        <MudStack Spacing="0"
                                  AlignItems="AlignItems.Center">
                            @($"Save Last {Controller.Settings.ReplaySeconds} Seconds")
                            @if (Shell.HotkeyProblem is null)
                            {
                                <MudText Typo="Typo.caption"
                                         Class="button-hint">
                                    @($"or {Controller.Settings.Hotkey}")
                                </MudText>
                            }
                        </MudStack>
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    </ChildContent>
</Header>
