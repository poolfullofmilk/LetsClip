@* Device Select *@
<FieldDetail Class="fixed-width"
             Detail="@Detail">
    <ChoiceSelect T="string"
                  Value="@Shown"
                  ValueChanged="ValueChanged"
                  ToStringFunc="LabelOf"
                  Label="@Label"
                  Disabled="@(Disabled || Devices is [])">
        @if (FirstChoice is { } first)
        {
            <MudSelectItem T="string"
                           Value="@FirstChoiceId"
                           Disabled="FirstChoiceDisabled"
                           Class="divided">
                <ItemLabel Text="@first"
                           Checked="@IsChecked(FirstChoiceId)" />
            </MudSelectItem>
        }
        <MudSelectItem T="string"
                       Value="@AudioDevices.AutomaticId"
                       Class="divided">
            <ItemLabel Text="Automatic"
                       Checked="@IsChecked(AudioDevices.AutomaticId)" />
        </MudSelectItem>
        @foreach (var device in Listed)
        {
            <MudSelectItem T="string"
                           Value="device.Id">
                <ItemLabel Text="@device.Name"
                           Detail="@device.Adapter"
                           Checked="@IsChecked(device.Id)" />
            </MudSelectItem>
        }
    </ChoiceSelect>
    @ChildContent
</FieldDetail>
