@* Source Chip *@
<MudChip T="string"
         Icon="@(Clip.Game is null ? Icons.Material.Rounded.Monitor : Icons.Material.Rounded.SportsEsports)"
         Size="Size.Small"
         Variant="@(OnPicture ? Variant.Filled : Variant.Text)"
         Color="@(OnPicture ? Color.Dark : Color.Default)"
         Class="@(OnClick.HasDelegate ? "source-chip action-chip ma-0" : "source-chip ma-0")"
         OnClick="OnClick">
    @Clip.Source
</MudChip>
