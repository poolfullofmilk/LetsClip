@* Capture Chip *@
<Tooltip Text="@Tip"
         RootClass="d-flex">
    <MudChip T="string"
             Icon="@Icon"
             IconColor="@IconColor"
             Color="@ChipColor"
             Size="Size.Small"
             Variant="Variant.Text"
             OnClick="OpenClips">
        @Label
    </MudChip>
</Tooltip>
