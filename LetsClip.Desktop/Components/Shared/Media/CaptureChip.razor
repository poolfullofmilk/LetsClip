@* Capture Chip *@
<Tooltip Text="@(Fix?.Text ?? HeldText)"
         Placement="Placement.Bottom">
    <MudChip T="string"
             Icon="@Icon"
             IconColor="@IconColor"
             Color="@ChipColor"
             Size="Size.Small"
             Variant="Variant.Text"
             Class="@ChipClass"
             OnClick="OpenFix">
        @Controller.StatusText
    </MudChip>
</Tooltip>
