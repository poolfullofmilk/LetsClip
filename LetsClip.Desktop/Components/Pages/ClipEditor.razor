@page "/clips/{FileName}"

<PageTitle>@Title</PageTitle>

@if (_missing)
{
    <MudPaper Elevation="4"
              Class="rounded-panel">
        <EmptyState Icon="@Icons.Material.Rounded.VideocamOff"
                    Color="Color.Warning"
                    Text="This clip was moved or deleted outside LetsClip">
            @* Back Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.ArrowBack"
                       OnClick="Back">
                All Clips
            </MudButton>
        </EmptyState>
    </MudPaper>
}
else
{
    <MudStack Spacing="2"
              Class="page-fill">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2"
                  Class="header-row">
            @* Back Button *@
            <IconButton Icon="@Icons.Material.Rounded.ArrowBack"
                        Text="All Clips"
                        OnClick="Back" />
            <MudStack Spacing="0"
                      Class="header-title ml-1">
                @if (_renaming is not null)
                {
                    @* Name Field *@
                    <MudTextField T="string"
                                  @bind-Value="_renaming"
                                  Immediate
                                  AutoFocus
                                  Underline="false"
                                  Placeholder="@DefaultTitle"
                                  OnKeyDown="RenameKey"
                                  OnBlur="CommitRename"
                                  aria-label="Clip Name"
                                  Class="rename-field my-0" />
                }
                else
                {
                    <MudText Typo="Typo.h5"
                             Class="ellipsis">
                        @Title
                    </MudText>
                }
                @if (Subtitle is { } subtitle)
                {
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary ellipsis">
                        @subtitle
                    </MudText>
                }
            </MudStack>
            @* Rename Button *@
            <IconButton Icon="@Icons.Material.Rounded.Edit"
                        Text="Rename Clip"
                        Disabled="@(_clip is null || _renaming is not null)"
                        OnClick="StartRename" />
            <MudSpacer />
            @if (_clip?.HasOriginal == true)
            {
                @* Restore Button *@
                <IconButton Icon="@Icons.Material.Rounded.Restore"
                            Text="Restore Original"
                            OnClick="RestoreOriginalAsync" />
            }
            @* Show In Folder Button *@
            <IconButton Icon="@Icons.Material.Rounded.FolderOpen"
                        Text="Show in Folder"
                        OnClick="ShowInFolder" />
            @* Delete Button *@
            <IconButton Icon="@Icons.Material.Rounded.Delete"
                        Text="Delete Clip"
                        Color="Color.Error"
                        OnClick="DeleteAsync" />
        </MudStack>

        <MudElement HtmlTag="div"
                    Class="split fill editor"
                    Style="@($"--clip-aspect:{Exact(ClipAspect)}")">
            <MudElement HtmlTag="div"
                        Class="main-panel fill-column">
                <MudPaper Elevation="4"
                          Class="rounded-panel pa-6 fill fill-column">
                    <MudStack Spacing="3"
                              Class="fill">
                        @* Player *@
                        <MudElement HtmlTag="div"
                                    Class="player fill">
                            @if (!_ready && !_playError)
                            {
                                <MudProgressCircular Color="Color.Info"
                                                     Size="Size.Large"
                                                     Indeterminate />
                            }
                            <MudElement @bind-Ref="_video"
                                        HtmlTag="video"
                                        Class="@(_ready ? null : "d-none")"
                                        src="@VideoUrl"
                                        preload="auto"
                                        playsinline
                                        controlslist="nodownload noplaybackrate noremoteplayback"
                                        disablepictureinpicture
                                        aria-label="Clip Preview" />
                            @if (_volumeShown > 0)
                            {
                                @* Volume Overlay *@
                                <MudElement @key="_volumeShown"
                                            HtmlTag="div"
                                            Class="player-overlay"
                                            aria-hidden="true">
                                    <MudIcon Icon="@VolumeButton.IconOf(_muted ? 0 : _volume)" />
                                    <MudText Typo="Typo.h6">@VolumeText</MudText>
                                </MudElement>
                            }
                        </MudElement>

                        @if (_playError)
                        {
                            <Notice Text="This clip could not play, it may be in use or damaged" />
                        }

                        @* Player Controls *@
                        <MudElement HtmlTag="div"
                                    Class="player-controls">
                            <PlayerClock @ref="_clock"
                                         @key="_path"
                                         Start="_range.Start"
                                         Duration="_duration" />
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Justify="Justify.Center"
                                      Spacing="1">
                                @* Set Start Button *@
                                <IconButton Icon="@Icons.Material.Rounded.FirstPage"
                                            Text="Set Start Here"
                                            Disabled="@(!_ready)"
                                            OnClick="SetStartAtPlayhead" />
                                @* Back Button *@
                                <IconButton Icon="@Icons.Material.Rounded.Replay5"
                                            Text="Back 5 Seconds"
                                            Disabled="@(!_ready)"
                                            OnClick="() => NudgeAsync(-SeekStep)" />
                                @* Play Button *@
                                <IconButton Icon="@(_paused ? Icons.Material.Rounded.PlayArrow : Icons.Material.Rounded.Pause)"
                                            Text="@PlayTip"
                                            Color="Color.Info"
                                            Filled
                                            Disabled="@(!_ready)"
                                            OnClick="TogglePlayAsync" />
                                @* Forward Button *@
                                <IconButton Icon="@Icons.Material.Rounded.Forward5"
                                            Text="Forward 5 Seconds"
                                            Disabled="@(!_ready)"
                                            OnClick="() => NudgeAsync(SeekStep)" />
                                @* Set End Button *@
                                <IconButton Icon="@Icons.Material.Rounded.LastPage"
                                            Text="Set End Here"
                                            Disabled="@(!_ready)"
                                            OnClick="SetEndAtPlayhead" />
                            </MudStack>
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Justify="Justify.FlexEnd"
                                      Spacing="1">
                                @* Mute Button *@
                                <VolumeButton Text="@MuteTip"
                                              Disabled="@(!_ready)"
                                              OnClick="ToggleMuteAsync"
                                              Value="@(_muted ? 0 : _volume)"
                                              ValueChanged="SetVolumeAsync" />
                                @* Full Screen Button *@
                                <IconButton Icon="@Icons.Material.Rounded.Fullscreen"
                                            Text="Full Screen"
                                            Disabled="@(!_ready)"
                                            OnClick="FullScreenAsync" />
                            </MudStack>
                        </MudElement>

                        @* Timeline *@
                        <MudElement HtmlTag="div"
                                    Class="@(_ready ? "timeline" : "timeline loading")">
                            @if (_stripUrl is { } strip)
                            {
                                <MudImage Src="@strip"
                                          Alt=""
                                          Class="timeline-strip" />
                            }
                            <MudElement @bind-Ref="_timeline"
                                        HtmlTag="div"
                                        Class="timeline-track"
                                        aria-label="Trim Timeline">
                                <MudElement HtmlTag="div"
                                            Class="timeline-shade before"
                                            Style="@($"left:0; width:{Percent(_range.Start)}")" />
                                <MudElement HtmlTag="div"
                                            Class="timeline-shade after"
                                            Style="@($"left:{Percent(_range.End)}; right:0")" />
                                <MudElement HtmlTag="div"
                                            Class="timeline-selection"
                                            Style="@($"left:{Percent(_range.Start)}; width:{Percent(_range.Length)}")" />
                                <MudElement @bind-Ref="_playhead"
                                            HtmlTag="div"
                                            Class="timeline-playhead"
                                            Style="left:0" />
                                @* Start Handle *@
                                <MudElement HtmlTag="div"
                                            Class="timeline-handle"
                                            Style="@($"left:{Percent(_range.Start)}")"
                                            role="slider"
                                            tabindex="0"
                                            data-handle="start"
                                            data-time="@Exact(_range.Start)"
                                            aria-label="Trim Start"
                                            aria-valuemin="0"
                                            aria-valuemax="@Exact(_range.End)"
                                            aria-valuenow="@Exact(_range.Start)"
                                            aria-valuetext="@Formatter.FormatDuration(_range.Start)" />
                                @* End Handle *@
                                <MudElement HtmlTag="div"
                                            Class="timeline-handle"
                                            Style="@($"left:{Percent(_range.End)}")"
                                            role="slider"
                                            tabindex="0"
                                            data-handle="end"
                                            data-time="@Exact(_range.End)"
                                            aria-label="Trim End"
                                            aria-valuemin="@Exact(_range.Start)"
                                            aria-valuemax="@Exact(_duration)"
                                            aria-valuenow="@Exact(_range.End)"
                                            aria-valuetext="@Formatter.FormatDuration(_range.End)" />
                            </MudElement>
                        </MudElement>

                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="5"
                                  Class="trim-row">
                            <TrimField Label="Start"
                                       Value="_range.Start"
                                       Disabled="@(!_ready)"
                                       OnCommit="SetStartAsync" />
                            <TrimField Label="End"
                                       Value="_range.End"
                                       Disabled="@(!_ready)"
                                       OnCommit="SetEndAsync" />
                            <MudSpacer />
                            @* Selection Length *@
                            <MudText Typo="Typo.body2"
                                     Class="selectable-text player-time">
                                <MudElement HtmlTag="span"
                                            Class="mud-text-secondary mr-2">
                                    Length
                                </MudElement>
                                <MudElement HtmlTag="span"
                                            data-length>
                                    @Formatter.FormatDuration(_range.Length)
                                </MudElement>
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudElement>

            <MudElement HtmlTag="div"
                        Class="side-panel">
                @if (_media is { } media && _clip is { } clip)
                {
                    <ExportPanel @key="clip.Path"
                                 Clip="clip"
                                 OnSaveCut="SaveCutAsync"
                                 Range="_range"
                                 Media="media" />
                }
            </MudElement>
        </MudElement>
    </MudStack>
}
