@page "/clips/{FileName}"

<PageTitle>@Title</PageTitle>

@if (_missing)
{
    <MudPaper Elevation="4"
              Class="rounded-panel">
        <EmptyState Icon="@Icons.Material.Rounded.VideocamOff"
                    Color="Color.Warning"
                    Text="This clip was moved or deleted outside LetsClip">
            @* Back Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.ArrowBack"
                       OnClick="Back">
                Back to Clips
            </MudButton>
        </EmptyState>
    </MudPaper>
}
else
{
    <MudStack Spacing="2"
              Class="page-fill">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="1"
                  Class="header-row">
            @* Back Button *@
            <IconButton Icon="@Icons.Material.Rounded.ArrowBack"
                        Text="Back to Clips"
                        OnClick="Back" />
            <MudText Typo="Typo.h5"
                     Class="header-title mx-2">
                @Title
            </MudText>
            <MudSpacer />
            @if (_clip?.HasOriginal == true)
            {
                @* Restore Button *@
                <IconButton Icon="@Icons.Material.Rounded.Restore"
                            Text="Restore Original"
                            Placement="Placement.Left"
                            Disabled="@(_exporting || _swapping)"
                            OnClick="RestoreOriginalAsync" />
            }
            @* Copy Button *@
            <IconButton Icon="@Icons.Material.Rounded.ContentCopy"
                        Text="Copy File"
                        Placement="Placement.Left"
                        Disabled="_swapping"
                        OnClick="CopyFile" />
            @* Show In Folder Button *@
            <IconButton Icon="@Icons.Material.Rounded.FolderOpen"
                        Text="Show in Folder"
                        Placement="Placement.Left"
                        OnClick="ShowInFolder" />
            @* Delete Button *@
            <IconButton Icon="@Icons.Material.Rounded.Delete"
                        Text="Delete Clip"
                        Placement="Placement.Left"
                        Color="Color.Error"
                        Disabled="@(_exporting || _swapping)"
                        OnClick="DeleteAsync" />
        </MudStack>

        <MudElement HtmlTag="div"
                    Class="split fill editor"
                    Style="@($"--clip-aspect:{Exact(ClipAspect)}")">
            <MudElement HtmlTag="div"
                        Class="main-panel fill-column">
                <MudPaper Elevation="4"
                          Class="rounded-panel pa-6 fill fill-column">
                    <MudStack Spacing="3"
                              Class="fill">
                        @* Player *@
                        <MudElement HtmlTag="div"
                                    Class="player fill">
                            @if (!_ready && !_playError)
                            {
                                <MudProgressCircular Color="Color.Info"
                                                     Size="Size.Large"
                                                     Indeterminate />
                            }
                            <MudElement @bind-Ref="_video"
                                        HtmlTag="video"
                                        Class="@(_ready ? null : "d-none")"
                                        src="@VideoUrl"
                                        preload="auto"
                                        playsinline
                                        controlslist="nodownload noplaybackrate noremoteplayback"
                                        disablepictureinpicture
                                        aria-label="Clip Preview" />
                            <MudElement HtmlTag="canvas"
                                        Class="player-frozen"
                                        aria-hidden="true" />
                            @if (_volumeShown > 0)
                            {
                                @* Volume Overlay *@
                                <MudElement @key="_volumeShown"
                                            HtmlTag="div"
                                            Class="player-overlay"
                                            aria-hidden="true">
                                    <MudIcon Icon="@VolumeButton.IconOf(_muted ? 0 : _volume)" />
                                    <MudText Typo="Typo.h6">@VolumeText</MudText>
                                </MudElement>
                            }
                        </MudElement>

                        @if (_playError)
                        {
                            <Notice Text="This clip could not play, it may be in use or damaged" />
                        }

                        @* Player Controls *@
                        <MudElement HtmlTag="div"
                                    Class="player-controls">
                            <MudElement HtmlTag="div"
                                        Class="control-line">
                                <TrimField Label="Start"
                                           Icon="@Icons.Material.Rounded.FirstPage"
                                           Value="_range.Start"
                                           Disabled="@(!_ready)"
                                           OnCommit="@(start => PlaceAsync("start", start))"
                                           OnSet="@(() => MarkAsync("start"))" />
                                <TrimField Label="End"
                                           Icon="@Icons.Material.Rounded.LastPage"
                                           Value="_range.End"
                                           Disabled="@(!_ready)"
                                           OnCommit="@(end => PlaceAsync("end", end))"
                                           OnSet="@(() => MarkAsync("end"))" />
                            </MudElement>
                            <MudElement HtmlTag="div"
                                        Class="transport">
                                <MudElement HtmlTag="div"
                                            Class="control-line">
                                    @* Back Button *@
                                    <IconButton Icon="@AppTheme.BackTwoIcon"
                                                Text="Back 2 Seconds"
                                                Square
                                                Disabled="@(!_ready)"
                                                OnClick="() => NudgeAsync(-SeekStep)" />
                                    @* Play Button *@
                                    <IconButton Icon="@(_paused ? Icons.Material.Rounded.PlayArrow : Icons.Material.Rounded.Pause)"
                                                Text="@PlayTip"
                                                Filled
                                                Square
                                                Disabled="@(!_ready)"
                                                OnClick="TogglePlayAsync" />
                                    @* Forward Button *@
                                    <IconButton Icon="@AppTheme.ForwardTwoIcon"
                                                Text="Forward 2 Seconds"
                                                Square
                                                Disabled="@(!_ready)"
                                                OnClick="() => NudgeAsync(SeekStep)" />
                                </MudElement>
                                <PlayerClock @ref="_clock"
                                             @key="_path"
                                             Start="_range.Start"
                                             Duration="_duration" />
                            </MudElement>
                            <MudElement HtmlTag="div"
                                        Class="control-line justify-end">
                                @* Mute Button *@
                                <VolumeButton Text="@MuteTip"
                                              Disabled="@(!_ready)"
                                              OnClick="ToggleMuteAsync"
                                              Value="@(_muted ? 0 : _volume)"
                                              ValueChanged="SetVolumeAsync" />
                                @* Full Screen Button *@
                                <IconButton Icon="@Icons.Material.Rounded.Fullscreen"
                                            Text="Full Screen"
                                            Disabled="@(!_ready)"
                                            OnClick="FullScreenAsync" />
                            </MudElement>
                        </MudElement>

                        @* Timeline *@
                        <MudElement HtmlTag="div"
                                    Class="@(_ready ? "timeline" : "timeline loading")">
                            @if (_stripUrl is { } strip)
                            {
                                <MudImage Src="@strip"
                                          Alt=""
                                          Class="timeline-strip" />
                            }
                            <MudElement @bind-Ref="_timeline"
                                        HtmlTag="div"
                                        Class="timeline-track"
                                        aria-label="Trim Timeline">
                                <MudElement HtmlTag="div"
                                            Class="timeline-shade before"
                                            Style="@($"left:0; width:{Percent(_range.Start)}")" />
                                <MudElement HtmlTag="div"
                                            Class="timeline-shade after"
                                            Style="@($"left:{Percent(_range.End)}; right:0")" />
                                <MudElement HtmlTag="div"
                                            Class="timeline-selection"
                                            Style="@($"left:{Percent(_range.Start)}; width:calc({Percent(_range.End)} - {Percent(_range.Start)})")" />
                                <MudElement @bind-Ref="_playhead"
                                            HtmlTag="div"
                                            Class="timeline-playhead"
                                            Style="left:0" />
                                @* Start Handle *@
                                <MudElement HtmlTag="div"
                                            Class="timeline-handle"
                                            Style="@($"left:{Percent(_range.Start)}")"
                                            role="slider"
                                            tabindex="0"
                                            data-handle="start"
                                            data-time="@Exact(_range.Start)"
                                            aria-label="Trim Start"
                                            aria-valuemin="0"
                                            aria-valuemax="@Exact(_range.End)"
                                            aria-valuenow="@Exact(_range.Start)"
                                            aria-valuetext="@Formatter.FormatDuration(_range.Start)" />
                                @* End Handle *@
                                <MudElement HtmlTag="div"
                                            Class="timeline-handle"
                                            Style="@($"left:{Percent(_range.End)}")"
                                            role="slider"
                                            tabindex="0"
                                            data-handle="end"
                                            data-time="@Exact(_range.End)"
                                            aria-label="Trim End"
                                            aria-valuemin="@Exact(_range.Start)"
                                            aria-valuemax="@Exact(_duration)"
                                            aria-valuenow="@Exact(_range.End)"
                                            aria-valuetext="@Formatter.FormatDuration(_range.End)" />
                            </MudElement>
                        </MudElement>

                    </MudStack>
                </MudPaper>
            </MudElement>

            <MudElement HtmlTag="div"
                        Class="side-panel">
                @if (_media is { } media && _clip is { } clip)
                {
                    @* Details Panel *@
                    <ExportPanel @key="clip.Path"
                                 Clip="clip"
                                 SaveCut="SaveCutAsync"
                                 CanSaveCut="@CanSaveCut()"
                                 Busy="_swapping"
                                 ExportingChanged="SetExporting"
                                 Range="_range"
                                 Media="media">
                        <SettingRow Title="Name">
                            @* Clip Name Field *@
                            <MudTextField @key="_path"
                                          @ref="_titleField"
                                          T="string"
                                          Value="_titleText"
                                          ValueChanged="TypeTitle"
                                          Immediate
                                          Placeholder="@clip.DefaultTitle"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          OnBlur="SettleTitle"
                                          OnKeyDown="TitleKeyAsync"
                                          aria-label="Clip Name"
                                          Class="content-field my-0" />
                        </SettingRow>
                        <SettingRow Title="Recorded">
                            <MudText Typo="Typo.body2"
                                     Class="mud-text-secondary">
                                @RecordedText
                            </MudText>
                        </SettingRow>
                    </ExportPanel>
                }
            </MudElement>
        </MudElement>
    </MudStack>
}
