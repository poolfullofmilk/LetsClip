@page "/clips/{FileName}"

<PageTitle>@Title</PageTitle>

@if (_missing)
{
    <MudPaper Elevation="4"
              Class="rounded-panel">
        <EmptyState Icon="@Icons.Material.Rounded.VideocamOff"
                    Color="Color.Warning"
                    Text="This clip was moved or deleted outside LetsClip">
            @* Back Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.ArrowBack"
                       OnClick="Back">
                All Clips
            </MudButton>
        </EmptyState>
    </MudPaper>
}
else
{
    <MudStack Spacing="6"
              Class="page-fill">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2"
                  Class="header-row">
            @* Back Button *@
            <Tooltip Text="All Clips"
                     RootClass="d-flex">
                <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack"
                               aria-label="All Clips"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               OnClick="Back" />
            </Tooltip>
            <MudStack Spacing="0"
                      Class="header-title">
                <MudText Typo="Typo.h5"
                         Class="ellipsis">
                    @Title
                </MudText>
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary ellipsis">
                    @_clip?.Details
                </MudText>
            </MudStack>
            <MudSpacer />
            @* Show In Folder Button *@
            <Tooltip Text="Show in Folder"
                     RootClass="d-flex">
                <MudIconButton Icon="@Icons.Material.Rounded.FolderOpen"
                               aria-label="Show in Folder"
                               Size="Size.Small"
                               OnClick="ShowInFolder" />
            </Tooltip>
            @* Delete Button *@
            <Tooltip Text="Delete Clip"
                     RootClass="d-flex">
                <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                               aria-label="Delete Clip"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="DeleteAsync" />
            </Tooltip>
        </MudStack>

        <MudElement HtmlTag="div"
                    Class="split fill">
            <MudElement HtmlTag="div"
                        Class="main-panel fill-column">
                <MudPaper Elevation="4"
                          Class="rounded-panel pa-6 fill fill-column">
                    <MudStack Spacing="3"
                              Class="fill">
                        @* Player *@
                        <MudElement HtmlTag="div"
                                    Class="player fill">
                            @if (!_ready && !_playError)
                            {
                                <MudProgressCircular Color="Color.Info"
                                                     Size="Size.Large"
                                                     Indeterminate />
                            }
                            <MudElement @bind-Ref="_video"
                                        HtmlTag="video"
                                        Class="@(_ready ? null : "d-none")"
                                        src="@VideoUrl"
                                        preload="auto"
                                        playsinline
                                        aria-label="Clip Preview" />
                        </MudElement>

                        @if (_playError)
                        {
                            <Notice Text="This clip could not play, it may be in use or damaged" />
                        }

                        @* Player Controls *@
                        <MudElement HtmlTag="div"
                                    Class="player-controls">
                            <PlayerClock @ref="_clock"
                                         @key="_path"
                                         Start="_range.Start"
                                         Duration="_duration" />
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Justify="Justify.Center"
                                      Spacing="1">
                                @* Set Start Button *@
                                <PlayerButton Icon="@Icons.Material.Rounded.FirstPage"
                                              Text="Set Start Here"
                                              Disabled="@(!_ready)"
                                              OnClick="SetStartAtPlayhead" />
                                @* Back Button *@
                                <PlayerButton Icon="@Icons.Material.Rounded.Replay"
                                              Text="Back 5 Seconds"
                                              Disabled="@(!_ready)"
                                              OnClick="() => NudgeAsync(-SeekStep)" />
                                @* Play Button *@
                                <PlayerButton Icon="@(_paused ? Icons.Material.Rounded.PlayArrow : Icons.Material.Rounded.Pause)"
                                              Text="@PlayTip"
                                              Filled
                                              Disabled="@(!_ready)"
                                              OnClick="TogglePlayAsync" />
                                @* Forward Button *@
                                <PlayerButton Icon="@Icons.Material.Rounded.Replay"
                                              Text="Forward 5 Seconds"
                                              Class="mirror"
                                              Disabled="@(!_ready)"
                                              OnClick="() => NudgeAsync(SeekStep)" />
                                @* Set End Button *@
                                <PlayerButton Icon="@Icons.Material.Rounded.LastPage"
                                              Text="Set End Here"
                                              Disabled="@(!_ready)"
                                              OnClick="SetEndAtPlayhead" />
                            </MudStack>
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Justify="Justify.FlexEnd"
                                      Spacing="1">
                                @* Reset Button *@
                                <PlayerButton Icon="@Icons.Material.Rounded.RestartAlt"
                                              Text="Reset Trim"
                                              Disabled="@(!_ready || _range == DefaultRange)"
                                              OnClick="ResetTrim" />
                                <MudElement HtmlTag="div"
                                            Class="volume">
                                    @* Mute Button *@
                                    <PlayerButton Icon="@(_muted ? Icons.Material.Rounded.VolumeOff : Icons.Material.Rounded.VolumeUp)"
                                                  Text="@MuteTip"
                                                  Disabled="@(!_ready)"
                                                  OnClick="ToggleMuteAsync" />
                                    @if (_ready)
                                    {
                                        <MudElement HtmlTag="div"
                                                    Class="volume-pop">
                                            <MudPaper Elevation="4"
                                                      Class="volume-paper rounded-inner">
                                                @* Volume Slider *@
                                                <MudSlider T="double"
                                                           Value="@(_muted ? 0 : _volume)"
                                                           ValueChanged="SetVolumeAsync"
                                                           Min="0"
                                                           Max="1"
                                                           Step="0.05"
                                                           Vertical
                                                           Color="Color.Info"
                                                           Size="Size.Medium"
                                                           Variant="Variant.Filled"
                                                           Immediate
                                                           aria-label="Volume" />
                                            </MudPaper>
                                        </MudElement>
                                    }
                                </MudElement>
                                @* Full Screen Button *@
                                <PlayerButton Icon="@Icons.Material.Rounded.Fullscreen"
                                              Text="Full Screen"
                                              Disabled="@(!_ready)"
                                              OnClick="FullScreenAsync" />
                            </MudStack>
                        </MudElement>

                        @* Timeline *@
                        <MudElement HtmlTag="div"
                                    Class="timeline">
                            <MudElement @bind-Ref="_timeline"
                                        HtmlTag="div"
                                        Class="timeline-track"
                                        aria-label="Trim Timeline">
                                @if (_stripUrl is { } strip)
                                {
                                    <MudImage Src="@strip"
                                              Alt=""
                                              Class="timeline-strip" />
                                }
                                <MudElement HtmlTag="div"
                                            Class="timeline-shade"
                                            Style="@($"left:0; width:{Percent(_range.Start)}")" />
                                <MudElement HtmlTag="div"
                                            Class="timeline-shade"
                                            Style="@($"left:{Percent(_range.End)}; right:0")" />
                                <MudElement HtmlTag="div"
                                            Class="timeline-selection"
                                            Style="@($"left:{Percent(_range.Start)}; width:{Percent(_range.Length)}")" />
                                <MudElement @bind-Ref="_playhead"
                                            HtmlTag="div"
                                            Class="timeline-playhead"
                                            Style="left:0" />
                                @* Start Handle *@
                                <MudElement HtmlTag="div"
                                            Class="timeline-handle"
                                            Style="@($"left:{Percent(_range.Start)}")"
                                            role="slider"
                                            tabindex="0"
                                            data-handle="start"
                                            data-time="@Exact(_range.Start)"
                                            aria-label="Trim Start"
                                            aria-valuemin="0"
                                            aria-valuemax="@Number(_range.End)"
                                            aria-valuenow="@Number(_range.Start)"
                                            aria-valuetext="@Formatter.FormatDuration(_range.Start)" />
                                @* End Handle *@
                                <MudElement HtmlTag="div"
                                            Class="timeline-handle"
                                            Style="@($"left:{Percent(_range.End)}")"
                                            role="slider"
                                            tabindex="0"
                                            data-handle="end"
                                            data-time="@Exact(_range.End)"
                                            aria-label="Trim End"
                                            aria-valuemin="@Number(_range.Start)"
                                            aria-valuemax="@Number(_duration)"
                                            aria-valuenow="@Number(_range.End)"
                                            aria-valuetext="@Formatter.FormatDuration(_range.End)" />
                            </MudElement>
                        </MudElement>

                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="5">
                            <TrimValue Label="Start"
                                       Value="@Formatter.FormatDuration(_range.Start)" />
                            <TrimValue Label="End"
                                       Value="@Formatter.FormatDuration(_range.End)" />
                            <TrimValue Label="Length"
                                       Value="@Formatter.FormatDuration(_range.Length)" />
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudElement>

            <MudElement HtmlTag="div"
                        Class="side-panel">
                @if (_media is { } media && _clip is { } clip)
                {
                    <ExportPanel @key="clip.Path"
                                 Clip="clip"
                                 Range="_range"
                                 Media="media" />
                }
            </MudElement>
        </MudElement>
    </MudStack>
}
