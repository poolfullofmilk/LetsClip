@page "/"
@page "/clips"

<PageTitle>Clips</PageTitle>

@{
    var shown = ShownClips;
    var day = default(DateTime?);
}

<MudElement HtmlTag="div"
            Class="page-fill fill-column">
    <Header Title="Clips"
            Scrolls>
        <TitleContent>
            <MudText Typo="Typo.subtitle1"
                     Class="mud-text-secondary">
                @CountText(shown.Count)
            </MudText>
            <MudSpacer />
            @* Clip Search *@
            <MudTextField T="string"
                          Value="s_query"
                          ValueChanged="SearchAsync"
                          Immediate
                          DebounceInterval="250"
                          Placeholder="Search"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Search"
                          Clearable
                          ClearIcon="@Icons.Material.Rounded.Clear"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="@(s_clips is not { Count: > 0 })"
                          aria-label="Search Clips"
                          Class="clip-search my-0" />
            @* Sort Menu *@
            <Tooltip Text="Sort Clips"
                     Disabled="@(shown.Count < 2)">
                <MudBadge Dot
                          Color="Color.Info"
                          Overlap
                          Visible="@(Controller.Settings.ClipSort != ClipSort.Newest)"
                          Class="d-flex">
                    <MudMenu Icon="@Icons.Material.Rounded.SwapVert"
                             AriaLabel="Sort Clips"
                             Size="Size.Small"
                             Dense
                             Disabled="@(shown.Count < 2)"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight">
                        @foreach (var sort in Enum.GetValues<ClipSort>())
                        {
                            @* Sort Item *@
                            <MudMenuItem OnClick="() => SetSortAsync(sort)">
                                <ItemLabel Text="@($"{sort} First")"
                                           Checked="@(sort == Controller.Settings.ClipSort)" />
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudBadge>
            </Tooltip>
            @* Filter *@
            <MudElement HtmlTag="div"
                        Class="d-flex">
                @* Filter Button *@
                <MudBadge Dot
                          Color="Color.Info"
                          Overlap
                          Visible="@IsFiltered"
                          Class="d-flex">
                    <IconButton Icon="@Icons.Material.Rounded.FilterList"
                                Text="Filter Clips"
                                Disabled="@(s_clips is not { Count: > 0 } && !IsFiltered)"
                                OnClick="OpenFilter" />
                </MudBadge>
                @* Filter Popover *@
                <MudPopover Open="_filterOpen"
                            AnchorOrigin="Origin.BottomRight"
                            TransformOrigin="Origin.TopRight"
                            Class="filter-popover">
                    <MudElement HtmlTag="div"
                                Class="filter-option">
                        @* Unedited Checkbox *@
                        <MudCheckBox T="bool"
                                     Value="_draftUnedited"
                                     ValueChanged="SetUneditedAsync"
                                     Color="Color.Info"
                                     CheckedIcon="@Icons.Material.Rounded.CheckBox"
                                     UncheckedIcon="@Icons.Material.Rounded.CheckBoxOutlineBlank"
                                     Dense>
                            <MudText Typo="Typo.body2">Only Unedited Clips</MudText>
                        </MudCheckBox>
                    </MudElement>
                    <MudElement HtmlTag="div"
                                Class="pa-3">
                        @* Game Search *@
                        <MudTextField T="string"
                                      @bind-Value="_search"
                                      Immediate
                                      Placeholder="Search"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Rounded.Search"
                                      Clearable
                                      ClearIcon="@Icons.Material.Rounded.Clear"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      aria-label="Search Games and Apps"
                                      Class="my-0" />
                    </MudElement>
                    <MudElement HtmlTag="div"
                                Class="filter-list">
                        @foreach (var game in SearchedGames)
                        {
                            @* Game Checkbox *@
                            <MudCheckBox T="bool"
                                         Value="@_draft.Contains(game)"
                                         ValueChanged="@(on => SetGameAsync(game, on))"
                                         Color="Color.Info"
                                         CheckedIcon="@Icons.Material.Rounded.CheckBox"
                                         UncheckedIcon="@Icons.Material.Rounded.CheckBoxOutlineBlank"
                                         Disabled="@(Games.Count < 2)"
                                         Dense>
                                <MudText Typo="Typo.body2">
                                    <MudHighlighter Text="@game"
                                                    HighlightedText="@_search" />
                                </MudText>
                            </MudCheckBox>
                        }
                    </MudElement>
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="4"
                              Class="filter-footer px-3 py-2">
                        @* Reset Button *@
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(!IsFiltered)"
                                   OnClick="ResetFilterAsync">
                            Reset
                        </MudButton>
                    </MudStack>
                </MudPopover>
            </MudElement>
            @* Filter Overlay *@
            <MudOverlay Visible="_filterOpen"
                        OnClick="CloseFilter"
                        AutoClose />
            @* Open Folder *@
            <IconButton Icon="@Icons.Material.Rounded.FolderOpen"
                        Text="Open Clips Folder"
                        OnClick="OpenFolder" />
        </TitleContent>
        <ChildContent>
            <CaptureNotice />
            @if (s_clips is null)
            {
                <Loading Class="page-loading" />
            }
            else if (s_clips.Count == 0 && Controller.Library.IsUnavailable)
            {
                <MudPaper Elevation="4"
                          Class="rounded-panel">
                    <EmptyState Icon="@Icons.Material.Rounded.FolderOff"
                                Color="Color.Warning"
                                Text="Clips Folder Not Available" />
                </MudPaper>
            }
            else if (s_clips.Count == 0)
            {
                <MudPaper Elevation="4"
                          Class="rounded-panel">
                    <EmptyState Icon="@Icons.Material.Rounded.VideoLibrary"
                                Text="No Clips Yet">
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary mt-n2">
                            @($"Press {Controller.Settings.Hotkey} To Save One")
                        </MudText>
                    </EmptyState>
                </MudPaper>
            }
            else if (shown.Count == 0)
            {
                <MudPaper Elevation="4"
                          Class="rounded-panel">
                    <EmptyState Icon="@Icons.Material.Rounded.FilterList"
                                Text="No Clips Match This Filter">
                        @* Show All Button *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="ShowAllAsync">
                            Show All Clips
                        </MudButton>
                    </EmptyState>
                </MudPaper>
            }
            else
            {
                @* Clip Cards *@
                <MudElement HtmlTag="div"
                            Class="clip-grid">
                    @foreach (var clip in shown.Take(s_cards))
                    {
                        @if (IsByDay && clip.RecordedAt.LocalDateTime.Date != day)
                        {
                            day = clip.RecordedAt.LocalDateTime.Date;
                            <MudText @key="day"
                                     Typo="Typo.h6"
                                     Class="clip-day">
                                @Formatter.FormatDay(clip.RecordedAt)
                            </MudText>
                        }

                        @* Clip Card *@
                        <MudPaper @key="clip.Path"
                                  Elevation="4"
                                  Class="rounded-panel pa-4 hover-card"
                                  role="button"
                                  tabindex="0"
                                  data-keyclick
                                  aria-label="@($"Open {clip.Title}")"
                                  aria-description="@FactsText(clip)"
                                  Style="@CardStyle(clip)"
                                  @onclick="() => Open(clip)">
                            <MudElement HtmlTag="div"
                                        Class="clip-thumb rounded-inner">
                                @if (clip.ThumbnailPath is not null)
                                {
                                    <MudImage Src="@DesktopShell.ThumbnailUrl(clip.ThumbnailPath)"
                                              Alt="@clip.Title"
                                              loading="lazy"
                                              decoding="async" />
                                }
                                else if (Controller.Library.IsMakingPictures)
                                {
                                    @* Picture Spinner *@
                                    <MudProgressCircular Color="Color.Info"
                                                         Size="Size.Small"
                                                         Indeterminate
                                                         Class="centred-spinner" />
                                }
                                <MudElement HtmlTag="div"
                                            Class="clip-preview"
                                            data-clip="@DesktopShell.ClipUrl(clip)" />
                                <SourceChip Clip="clip"
                                            OnPicture />
                                @* Picture Chips *@
                                <MudElement HtmlTag="div"
                                            Class="clip-chips">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Color="Color.Dark"
                                             Class="ma-0">
                                        @(IsByDay ? Formatter.FormatTime(clip.RecordedAt) : Formatter.FormatDateTime(clip.RecordedAt))
                                    </MudChip>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Color="Color.Dark"
                                             Class="ma-0">
                                        @Formatter.FormatDuration(clip.Duration)
                                    </MudChip>
                                </MudElement>
                            </MudElement>
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="1"
                                      Class="mt-2 clip-title-row">
                                <MudText Typo="Typo.subtitle2"
                                         Class="two-lines">
                                    <MudHighlighter Text="@clip.Title"
                                                    HighlightedText="@s_query" />
                                </MudText>
                                @* Clip Menu *@
                                <MudElement HtmlTag="span"
                                            Class="d-flex"
                                            ClickPropagation="false">
                                    <Tooltip Text="More">
                                        <MudMenu Icon="@Icons.Material.Rounded.MoreVert"
                                                 AriaLabel="More"
                                                 Size="Size.Small"
                                                 Dense
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight">
                                            @* Rename Clip *@
                                            <MudMenuItem Icon="@Icons.Material.Rounded.DriveFileRenameOutline"
                                                         Label="Rename"
                                                         Disabled="@Controller.Exports.IsExporting(clip.Path)"
                                                         OnClick="() => RenameAsync(clip)" />
                                            @* Copy File *@
                                            <MudMenuItem Icon="@Icons.Material.Rounded.ContentCopy"
                                                         Label="Copy File"
                                                         OnClick="() => DesktopShell.CopyFile(clip.Path, Snackbar)" />
                                            @* Show In Folder *@
                                            <MudMenuItem Icon="@Icons.Material.Rounded.FolderOpen"
                                                         Label="Show in Folder"
                                                         OnClick="() => Explorer.ShowFile(clip.Path)" />
                                            @* Details Menu *@
                                            <MudMenu StartIcon="@AppTheme.InfoIcon"
                                                     Label="Details"
                                                     Dense>
                                                <MudElement HtmlTag="div"
                                                            Class="info-facts">
                                                    @foreach (var fact in FactsOf(clip))
                                                    {
                                                        <MudText Typo="Typo.body2"
                                                                 Class="mud-text-secondary">
                                                            @fact.Label
                                                        </MudText>
                                                        <MudText Typo="Typo.body2">@fact.Value</MudText>
                                                    }
                                                </MudElement>
                                            </MudMenu>
                                            <MudDivider />
                                            @* Delete Clip *@
                                            <MudMenuItem Icon="@Icons.Material.Rounded.Delete"
                                                         IconColor="Color.Error"
                                                         Label="Delete Clip"
                                                         Disabled="@Controller.Exports.IsExporting(clip.Path)"
                                                         OnClick="() => DeleteAsync(clip)" />
                                        </MudMenu>
                                    </Tooltip>
                                </MudElement>
                            </MudStack>
                        </MudPaper>
                    }
                </MudElement>
            }
        </ChildContent>
    </Header>
</MudElement>
