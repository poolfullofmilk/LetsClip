@page "/"
@page "/clips"

<PageTitle>Clips</PageTitle>

<MudElement HtmlTag="div"
            Class="split">
    <MudElement HtmlTag="div"
                Class="side-panel">
        <CapturePanel />
    </MudElement>

    <MudElement HtmlTag="div"
                Class="main-panel">
        <Header Title="Clips">
            <TitleContent>
                <MudText Typo="Typo.subtitle1"
                         Class="mud-text-secondary">
                    @CountText
                </MudText>
                <MudSpacer />
                @* Game Filter Button *@
                <MudBadge Dot
                          Color="Color.Info"
                          Overlap
                          Visible="@IsFiltered"
                          Class="d-flex">
                    <IconButton Icon="@Icons.Material.Rounded.FilterList"
                                Text="Filter by Game"
                                Disabled="@(Games.Count < 2 && !IsFiltered)"
                                OnClick="OpenFilter" />
                </MudBadge>
                @* Game Filter Popover *@
                <MudPopover Open="_filterOpen"
                            AnchorOrigin="Origin.BottomRight"
                            TransformOrigin="Origin.TopRight"
                            Class="filter-popover">
                    <MudElement HtmlTag="div"
                                Class="pa-3">
                        @* Game Search *@
                        <MudTextField T="string"
                                      @bind-Value="_search"
                                      Immediate
                                      Placeholder="Search"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Rounded.Search"
                                      Clearable
                                      ClearIcon="@Icons.Material.Rounded.Clear"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      aria-label="Search Games"
                                      Class="my-0" />
                    </MudElement>
                    <MudElement HtmlTag="div"
                                Class="filter-list">
                        @if (string.IsNullOrWhiteSpace(_search))
                        {
                            @* All Games Checkbox *@
                            <MudCheckBox T="bool?"
                                         Value="AllState"
                                         ValueChanged="SetAll"
                                         Color="Color.Info"
                                         CheckedIcon="@Icons.Material.Rounded.CheckBox"
                                         UncheckedIcon="@Icons.Material.Rounded.CheckBoxOutlineBlank"
                                         IndeterminateIcon="@Icons.Material.Rounded.IndeterminateCheckBox"
                                         Dense>
                                <MudText Typo="Typo.body2">All</MudText>
                            </MudCheckBox>
                        }
                        @foreach (var game in SearchedGames)
                        {
                            @* Game Checkbox *@
                            <MudCheckBox T="bool"
                                         Value="@_draft.Contains(game)"
                                         ValueChanged="@(on => SetGame(game, on))"
                                         Color="Color.Info"
                                         CheckedIcon="@Icons.Material.Rounded.CheckBox"
                                         UncheckedIcon="@Icons.Material.Rounded.CheckBoxOutlineBlank"
                                         Dense>
                                <MudText Typo="Typo.body2">
                                    <MudHighlighter Text="@game"
                                                    HighlightedText="@_search" />
                                </MudText>
                            </MudCheckBox>
                        }
                    </MudElement>
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="4"
                              Class="filter-footer px-3 py-2">
                        @* Reset Button *@
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="ResetFilter">
                            Reset
                        </MudButton>
                        <MudSpacer />
                        @* Apply Button *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   Disabled="@(_draft.Count == 0)"
                                   OnClick="ApplyFilter">
                            Apply
                        </MudButton>
                    </MudStack>
                </MudPopover>
                @* Filter Overlay *@
                <MudOverlay Visible="_filterOpen"
                            OnClick="CloseFilter"
                            AutoClose />
                @* Open Folder *@
                <IconButton Icon="@Icons.Material.Rounded.FolderOpen"
                            Text="Open Clips Folder"
                            OnClick="OpenFolder" />
            </TitleContent>
            <ChildContent>
                @if (_clips is null)
                {
                    <Loading Class="page-loading" />
                }
                else if (_clips.Count == 0)
                {
                    <MudPaper Elevation="4"
                              Class="rounded-panel">
                        <EmptyState Icon="@Icons.Material.Rounded.VideoLibrary"
                                    Color="Color.Default"
                                    Text="No Clips" />
                    </MudPaper>
                }
                else if (ShownClips.Count == 0)
                {
                    <MudPaper Elevation="4"
                              Class="rounded-panel">
                        <EmptyState Icon="@Icons.Material.Rounded.FilterList"
                                    Color="Color.Default"
                                    Text="No Clips for These Games">
                            @* Show All Button *@
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="ShowAll">
                                Show All Clips
                            </MudButton>
                        </EmptyState>
                    </MudPaper>
                }
                else
                {
                    @* Clip Cards *@
                    <MudElement HtmlTag="div"
                                Class="clip-grid">
                        @foreach (var clip in ShownClips)
                        {
                            @* Clip Card *@
                            <MudPaper @key="clip.Path"
                                      Elevation="4"
                                      Class="rounded-panel pa-4 hover-card"
                                      role="button"
                                      tabindex="0"
                                      data-keyclick
                                      aria-label="@($"Open {clip.Title}")"
                                      Style="@($"view-transition-name:{CardName(clip)}")"
                                      @onclick="() => Open(clip)">
                                <MudElement HtmlTag="div"
                                            Class="clip-thumb rounded-inner">
                                    @if (DesktopShell.ThumbnailUrl(clip.ThumbnailPath) is { Length: > 0 } thumbnail)
                                    {
                                        <MudImage Src="@thumbnail"
                                                  Alt="@clip.Title" />
                                    }
                                    <MudStack Spacing="1"
                                              AlignItems="AlignItems.Start"
                                              Class="clip-facts">
                                        @foreach (var fact in FactsOf(clip))
                                        {
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Variant="Variant.Filled"
                                                     Color="Color.Dark"
                                                     Class="ma-0">
                                                @fact
                                            </MudChip>
                                        }
                                    </MudStack>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Color="Color.Dark"
                                             Class="clip-duration ma-0">
                                        @Formatter.FormatDuration(clip.Duration)
                                    </MudChip>
                                </MudElement>
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="1"
                                          Class="mt-2">
                                    <MudText Typo="Typo.h6"
                                             Class="ellipsis flex-grow-1">
                                        @clip.Title
                                    </MudText>
                                    @* Delete Button *@
                                    <MudElement HtmlTag="span"
                                                ClickPropagation="false">
                                        <IconButton Icon="@Icons.Material.Rounded.Delete"
                                                    Text="Delete Clip"
                                                    Color="Color.Error"
                                                    OnClick="() => DeleteAsync(clip)" />
                                    </MudElement>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudElement>
                }
            </ChildContent>
        </Header>
    </MudElement>
</MudElement>
