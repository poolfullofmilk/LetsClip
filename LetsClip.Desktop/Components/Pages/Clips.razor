@page "/"
@page "/clips"

<PageTitle>Clips</PageTitle>

@{
    var shown = ShownClips;
    var group = default(string?);
}

<MudElement HtmlTag="div"
            Class="page-fill fill-column">
    <Header Title="Clips"
            Scrolls>
        <TitleContent>
            <MudText Typo="Typo.subtitle1"
                     Class="mud-text-secondary">
                @CountText(shown.Count)
            </MudText>
            <MudSpacer />
            @* Clip Search *@
            <SearchField Value="@s_query"
                         ValueChanged="SearchAsync"
                         DebounceInterval="250"
                         Disabled="@(s_clips is not { Count: > 0 })"
                         aria-label="Search Clips"
                         Class="clip-search my-0" />
            @* Sort Menu *@
            <Tooltip Text="Sort Clips"
                     Disabled="@(shown.Count < 2)">
                <MudBadge Dot
                          Color="Color.Info"
                          Overlap
                          Visible="@(Controller.Settings.ClipSort != ClipSort.Newest)"
                          Class="d-flex">
                    <MudMenu Icon="@Icons.Material.Rounded.SwapVert"
                             AriaLabel="Sort Clips"
                             Size="Size.Small"
                             Dense
                             Disabled="@(shown.Count < 2)"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight">
                        @foreach (var sort in Enum.GetValues<ClipSort>())
                        {
                            @* Sort Item *@
                            <MudMenuItem OnClick="() => SetSortAsync(sort)">
                                <ItemLabel Text="@($"{sort} First")"
                                           Checked="@(sort == Controller.Settings.ClipSort)" />
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudBadge>
            </Tooltip>
            @* Filter *@
            <MudElement HtmlTag="div"
                        Class="d-flex">
                @* Filter Button *@
                <MudBadge Dot
                          Color="Color.Info"
                          Overlap
                          Visible="@IsFiltered"
                          Class="d-flex">
                    <IconButton Icon="@Icons.Material.Rounded.FilterList"
                                Text="Filter by Source"
                                Disabled="@(s_clips is not { Count: > 0 } && !IsFiltered)"
                                OnClick="OpenFilter" />
                </MudBadge>
                @* Filter Popover *@
                <MudPopover Open="_filterOpen"
                            AnchorOrigin="Origin.BottomRight"
                            TransformOrigin="Origin.TopRight"
                            Class="form-popover">
                    <MudElement HtmlTag="div"
                                Class="filter-option">
                        @* Unedited Checkbox *@
                        <MudCheckBox T="bool"
                                     Value="_draftUnedited"
                                     ValueChanged="SetUneditedAsync"
                                     Color="Color.Info"
                                     CheckedIcon="@Icons.Material.Rounded.CheckBox"
                                     UncheckedIcon="@Icons.Material.Rounded.CheckBoxOutlineBlank"
                                     Disabled="@UneditedDisabled"
                                     Dense>
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Justify="Justify.SpaceBetween"
                                      Spacing="4">
                                <MudText Typo="Typo.body2">Only Unedited Clips</MudText>
                                <MudText Typo="Typo.body2"
                                         Class="mud-text-secondary flex-shrink-0">
                                    @UneditedCount
                                </MudText>
                            </MudStack>
                        </MudCheckBox>
                    </MudElement>
                    <MudElement HtmlTag="div"
                                Class="pa-3">
                        @* Game Search *@
                        <SearchField @bind-Value="_search"
                                     Placeholder="Search Sources"
                                     Disabled="@OneSource"
                                     aria-label="Search Sources" />
                    </MudElement>
                    <MudElement HtmlTag="div"
                                Class="filter-list">
                        @foreach (var game in SearchedGames)
                        {
                            @* Game Checkbox *@
                            <MudCheckBox T="bool"
                                         Value="@_draft.Contains(game)"
                                         ValueChanged="@(on => SetGameAsync(game, on))"
                                         Color="Color.Info"
                                         CheckedIcon="@Icons.Material.Rounded.CheckBox"
                                         UncheckedIcon="@Icons.Material.Rounded.CheckBoxOutlineBlank"
                                         Disabled="@OneSource"
                                         Dense>
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Justify="Justify.SpaceBetween"
                                          Spacing="4">
                                    <MudText Typo="Typo.body2">
                                        <MudHighlighter Text="@game"
                                                        HighlightedText="@_search" />
                                    </MudText>
                                    <MudText Typo="Typo.body2"
                                             Class="mud-text-secondary flex-shrink-0">
                                        @CountOf(game)
                                    </MudText>
                                </MudStack>
                            </MudCheckBox>
                        }
                    </MudElement>
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="4"
                              Class="popover-footer px-3 py-2">
                        @* Reset Button *@
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(!IsFiltered)"
                                   OnClick="ResetFilterAsync">
                            Reset
                        </MudButton>
                    </MudStack>
                </MudPopover>
            </MudElement>
            @* Filter Overlay *@
            <MudOverlay Visible="_filterOpen"
                        OnClick="CloseFilter"
                        AutoClose />
            @* Open Folder *@
            <IconButton Icon="@Icons.Material.Rounded.FolderOpen"
                        Text="Open Clips Folder"
                        OnClick="OpenFolder" />
        </TitleContent>
        <ChildContent>
            <CaptureNotice />
            @if (s_clips is null)
            {
                <Loading Class="page-loading" />
            }
            else if (s_clips.Count == 0 && Controller.Library.IsUnavailable)
            {
                <MudPaper Elevation="4"
                          Class="rounded-panel">
                    <EmptyState Icon="@Icons.Material.Rounded.FolderOff"
                                Color="Color.Warning"
                                Text="Clips Folder Not Available" />
                </MudPaper>
            }
            else if (s_clips.Count == 0)
            {
                <NoClips />
            }
            else if (shown.Count == 0)
            {
                <MudPaper Elevation="4"
                          Class="rounded-panel">
                    <EmptyState Icon="@Icons.Material.Rounded.FilterList"
                                Text="No Clips Match This Filter">
                        @* Show All Button *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="ShowAllAsync">
                            Show All Clips
                        </MudButton>
                    </EmptyState>
                </MudPaper>
            }
            else
            {
                @* Clip Cards *@
                <MudElement HtmlTag="div"
                            Class="clip-grid">
                    @foreach (var clip in shown.Take(s_cards))
                    {
                        @if (IsGrouped && GroupOf(clip) is var next && next != group)
                        {
                            group = next;
                            <MudText @key="next"
                                     Typo="Typo.h6"
                                     Class="clip-day">
                                @next
                            </MudText>
                        }

                        @* Clip Card *@
                        <ClipCard @key="clip.Path"
                                  Clip="clip"
                                  IsNew="@IsNew(clip)"
                                  Query="@s_query"
                                  Time="@TimeOf(clip)"
                                  CardStyle="@CardStyle(clip)"
                                  Exporting="@Controller.Exports.IsExporting(clip.Path)"
                                  MakingPicture="@(clip.ThumbnailPath is null && Controller.Library.IsMakingPictures)"
                                  SoundOnly="@SoundOnly"
                                  Open="() => Open(clip)"
                                  Rename="() => RenameAsync(clip)"
                                  Delete="() => DeleteAsync(clip)"
                                  CopyForDiscord="plan => CopyForDiscordAsync(clip, plan)" />
                    }
                </MudElement>
            }
        </ChildContent>
    </Header>
</MudElement>
