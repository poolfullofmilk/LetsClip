@page "/settings"

<PageTitle>Settings</PageTitle>

<Header Title="Settings">
    <ChildContent>
        <MudStack Spacing="6">
            @* Recording Settings *@
            <MudPaper Elevation="4"
                      Class="rounded-panel px-6 py-2">
                <MudText Typo="Typo.h6"
                         Class="pt-2">
                    Recording
                </MudText>
                <SettingRow Title="Games Only">
                    @* Games Link *@
                    <MudLink Typo="Typo.body2"
                             Color="Color.Info"
                             OnClick="ShowGamesAsync">
                        @GamesLinkText
                    </MudLink>
                    @* Games Only Switch *@
                    <MudSwitch T="bool"
                               Value="Controller.Settings.GamesOnly"
                               ValueChanged="SetGamesOnly"
                               Color="Color.Info"
                               aria-label="Games Only"
                               Disabled="@GamesOnlyUnavailable"
                               Class="ma-0" />
                </SettingRow>
                <MudDivider />
                <SettingRow Title="Start with Windows">
                    @* Start With Windows Switch *@
                    <MudSwitch T="bool"
                               Value="Controller.Settings.StartWithWindows"
                               ValueChanged="SetStartWithWindows"
                               Color="Color.Info"
                               aria-label="Start with Windows"
                               Class="ma-0" />
                </SettingRow>
            </MudPaper>

            @* Saving Settings *@
            <MudPaper Elevation="4"
                      Class="rounded-panel px-6 py-2">
                <MudText Typo="Typo.h6"
                         Class="pt-2">
                    Saving
                </MudText>
                <SettingRow Title="Save Hotkey">
                    @if (_capturingKey)
                    {
                        <MudText Typo="Typo.body2"
                                 Class="mud-info-text">
                            Press the new keys, Escape cancels
                        </MudText>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Text">
                            @Shell.HotkeyText
                        </MudChip>
                        @* Change Hotkey Button *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="CaptureKeyAsync">
                            Change
                        </MudButton>
                    }
                </SettingRow>
                @if (HotkeyMessage() is { } hotkeyProblem)
                {
                    <Notice Text="@hotkeyProblem"
                            Class="mb-3" />
                }
                <MudDivider />
                <SettingRow Title="Save Sound">
                    @* Play Sound Button *@
                    <Tooltip Text="Play Sound"
                             RootClass="d-flex">
                        <MudIconButton Icon="@Icons.Material.Rounded.VolumeUp"
                                       aria-label="Play Sound"
                                       Size="Size.Small"
                                       OnClick="() => SaveChime.Play(Controller.Recorder)" />
                    </Tooltip>
                    @* Save Sound Switch *@
                    <MudSwitch T="bool"
                               Value="Controller.Settings.SaveSound"
                               ValueChanged="SetSaveSound"
                               Color="Color.Info"
                               aria-label="Save Sound"
                               Class="ma-0" />
                </SettingRow>
            </MudPaper>

            @* Audio Settings *@
            <MudPaper Elevation="4"
                      Class="rounded-panel px-6 py-2">
                <MudText Typo="Typo.h6"
                         Class="pt-2">
                    Audio
                </MudText>
                <SettingRow Title="System Audio">
                    @if (Controller.Settings.SystemAudio)
                    {
                        @* Playback Device Select *@
                        <MudElement HtmlTag="div"
                                    Class="fixed-width wide">
                            <MudSelect T="string"
                                       Value="Controller.Settings.SystemAudioDeviceId"
                                       ValueChanged="SetPlaybackDevice"
                                       ToStringFunc="PlaybackLabel"
                                       aria-label="Playback Device"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense
                                       AnchorOrigin="Origin.BottomLeft"
                                       TransformOrigin="Origin.TopLeft"
                                       Class="my-0">
                                <MudSelectItem T="string"
                                               Value="@AudioDevices.AutomaticId"
                                               Class="divided">
                                    <DeviceLabel Text="Automatic"
                                                 Detail="@DefaultName(_playback)" />
                                </MudSelectItem>
                                @foreach (var device in _playback)
                                {
                                    <MudSelectItem T="string"
                                                   Value="device.Id">
                                        <DeviceLabel Text="@device.Name" />
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudElement>
                    }
                    @* System Audio Switch *@
                    <MudSwitch T="bool"
                               Value="Controller.Settings.SystemAudio"
                               ValueChanged="SetSystemAudio"
                               Color="Color.Info"
                               aria-label="System Audio"
                               Disabled="@(!Controller.Settings.SystemAudio && _playback.Count == 0)"
                               Class="ma-0" />
                </SettingRow>
                <MudDivider />
                <SettingRow Title="Microphone">
                    @if (Controller.Settings.Microphone)
                    {
                        @* Microphone Select *@
                        <MudElement HtmlTag="div"
                                    Class="fixed-width wide">
                            <MudSelect T="string"
                                       Value="Controller.Settings.MicrophoneDeviceId"
                                       ValueChanged="SetMicrophoneDevice"
                                       ToStringFunc="MicrophoneLabel"
                                       aria-label="Microphone Device"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense
                                       AnchorOrigin="Origin.BottomLeft"
                                       TransformOrigin="Origin.TopLeft"
                                       Class="my-0">
                                <MudSelectItem T="string"
                                               Value="@AudioDevices.AutomaticId"
                                               Class="divided">
                                    <DeviceLabel Text="Automatic"
                                                 Detail="@DefaultName(_microphones)" />
                                </MudSelectItem>
                                @foreach (var device in _microphones)
                                {
                                    <MudSelectItem T="string"
                                                   Value="device.Id">
                                        <DeviceLabel Text="@device.Name" />
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudElement>
                    }
                    @* Microphone Switch *@
                    <MudSwitch T="bool"
                               Value="Controller.Settings.Microphone"
                               ValueChanged="SetMicrophone"
                               Color="Color.Info"
                               aria-label="Microphone"
                               Disabled="@(!Controller.Settings.Microphone && _microphones.Count == 0)"
                               Class="ma-0" />
                </SettingRow>
            </MudPaper>

            @* Storage Settings *@
            <MudPaper Elevation="4"
                      Class="rounded-panel px-6 py-2">
                <MudText Typo="Typo.h6"
                         Class="pt-2">
                    Storage
                </MudText>
                <SettingRow Title="Clips Folder">
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary ellipsis">
                        @ClipsFolderText
                    </MudText>
                    @* Change Folder Button *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               Size="Size.Small"
                               OnClick="PickFolder">
                        Change
                    </MudButton>
                    @if (Controller.Settings.ClipsFolder is not null)
                    {
                        @* Default Folder Button *@
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   OnClick="UseDefaultFolder">
                            Use Default
                        </MudButton>
                    }
                    @* Open Folder Button *@
                    <Tooltip Text="Open Clips Folder"
                             RootClass="d-flex">
                        <MudIconButton Icon="@Icons.Material.Rounded.FolderOpen"
                                       aria-label="Open Clips Folder"
                                       Size="Size.Small"
                                       OnClick="OpenFolder" />
                    </Tooltip>
                </SettingRow>
                @if (_folderError is { } folderError)
                {
                    <Notice Text="@folderError"
                            Class="mb-3" />
                }
            </MudPaper>
        </MudStack>
    </ChildContent>
</Header>
