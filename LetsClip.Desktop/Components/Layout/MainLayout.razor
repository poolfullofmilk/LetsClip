@inherits LayoutComponentBase

@* Providers *@
<MudThemeProvider Theme="AppTheme.Custom"
                  IsDarkMode
                  DefaultScrollbar />
<MudPopoverProvider />
<MudDialogProvider BackdropClick="false"
                   CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="4"
               Style="background-color:color-mix(in srgb, var(--mud-palette-appbar-background) var(--glass-opacity), transparent); backdrop-filter:var(--glass-blur)">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Class="mud-width-full px-2"
                  Spacing="2">
            <MudText Typo="Typo.h6"
                     Class="mud-typography-nowrap mr-2">
                @AppInfo.DisplayName
            </MudText>

            @* More Menu *@
            <MudBadge Dot
                      Color="Color.Error"
                      Overlap
                      Visible="@(Shell.AvailableUpdate is not null)"
                      Class="d-flex">
                <MudMenu @ref="_moreMenu"
                         Dense
                         AnchorOrigin="Origin.BottomLeft"
                         TransformOrigin="Origin.TopLeft">
                    <ActivatorContent>
                        @* More Button *@
                        <IconButton Icon="@Icons.Material.Rounded.MoreVert"
                                    Text="More"
                                    Busy="_checking"
                                    OnClick="OpenMoreAsync" />
                    </ActivatorContent>
                    <ChildContent>
                        @* Check Updates *@
                        <MudMenuItem Icon="@Icons.Material.Rounded.SystemUpdateAlt"
                                     Label="Check for Updates"
                                     Class="@(Shell.AvailableUpdate is null ? null : "update-dot")"
                                     OnClick="CheckForUpdatesAsync" />
                        @* Open Logs *@
                        <MudMenuItem Icon="@Icons.Material.Rounded.Description"
                                     Label="Open Logs Folder"
                                     OnClick="OpenLogs" />
                        <MudDivider />
                        @* About *@
                        <MudMenuItem Icon="@AppTheme.InfoIcon"
                                     Label="About"
                                     OnClick="ShowAboutAsync" />
                    </ChildContent>
                </MudMenu>
            </MudBadge>

            <MudSpacer />

            @* Hotkey Chip *@
            <HotkeyChip />
            @* Save Button, Only While Recording *@
            <SaveClipButton />
            @* Capture Chip *@
            <CaptureChip />
        </MudStack>
    </MudAppBar>

    @* Main Content *@
    <MudMainContent Class="page-gutter">
        <MudStack Row
                  AlignItems="AlignItems.Start"
                  Spacing="6">
            @* Navigation Panel *@
            <MudPaper Elevation="4"
                      Class="rounded-panel pa-2 nav-panel">
                <MudNavMenu Color="Color.Info"
                            Rounded
                            Margin="Margin.Dense">
                    @* Clips Link *@
                    <MudNavLink Href="clips"
                                Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Rounded.VideoLibrary">
                        Clips
                    </MudNavLink>
                    @* Settings Link *@
                    <MudNavLink Href="settings"
                                Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Rounded.Settings">
                        Settings
                    </MudNavLink>
                </MudNavMenu>
            </MudPaper>

            @* Page *@
            <MudElement HtmlTag="section"
                        Class="flex-grow-1 page"
                        Style="min-width:0">
                <SelfHealingBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <EmptyState Icon="@Icons.Material.Rounded.Error"
                                    Color="Color.Error"
                                    Text="Something went wrong on this page">
                            @* Recover *@
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="() => _errorBoundary?.BackToClips()">
                                Back to Clips
                            </MudButton>
                        </EmptyState>
                    </ErrorContent>
                </SelfHealingBoundary>
            </MudElement>
        </MudStack>
    </MudMainContent>
</MudLayout>
