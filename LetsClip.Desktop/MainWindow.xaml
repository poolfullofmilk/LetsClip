<Window
    x:Class="LetsClip.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
    xmlns:components="clr-namespace:LetsClip.Desktop.Components"
    xmlns:helpers="clr-namespace:LetsClip.Data.Helpers;assembly=LetsClip.Data"
    Title="{x:Static helpers:AppInfo.DisplayName}"
    Width="1280"
    Height="820"
    MinWidth="720"
    MinHeight="540"
    Background="#202020"
    WindowStartupLocation="CenterScreen"
>
    <!-- BlazorWebView -->
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html" StartPath="/clips">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
